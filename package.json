{
  "name": "oxideclub-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content:sync": "node scripts/sync-content.mjs",
    "predev": "npm run content:sync",
    "dev": "astro dev --host 0.0.0.0",
    "prebuild": "npm run content:sync",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "precheck": "npm run content:sync",
    "check": "astro check",
    "pretest": "npm run content:sync",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "prebuild:production": "node scripts/sync-content.mjs --production",
    "build:production": "node scripts/release-check.mjs && SITE_RELEASE=production astro build",
    "deploy": "npm run build:production && wrangler deploy",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "test:notes": "node --test tests/integration/notes.test.mjs",
    "test:meetings": "node --test tests/integration/meetings.test.mjs",
    "test:community": "node --test tests/integration/community.test.mjs",
    "test:labs": "node --test tests/integration/labs.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "ajv": "^8.20.0",
    "astro": "^7.4.0",
    "elkjs": "^0.12.0",
    "fflate": "0.8.3",
    "typescript": "^6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "wrangler": "^4.151.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxide-club/oxideclub.dev.git"
  }
}
