{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oxideclub-dev",
  "compatibility_date": "2026-10-18",
  "routes": [{ "pattern": "oxideclub.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
