---
import { links } from '../config/site';
const {
  secondary = false,
  label = 'Entrar no Discord',
  href = links.discord,
} = Astro.props;
---

{href ? (
  <a class:list={['button', { secondary }]} href={href}>
    {label}
    <span aria-hidden="true">↗</span>
  </a>
) : (
  <p class="notice">O convite para a comunidade será disponibilizado aqui.</p>
)}
