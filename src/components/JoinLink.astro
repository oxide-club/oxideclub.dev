---
import ButtonLink from './ui/ButtonLink.astro';
import { links } from '../config/site';
const {
  secondary = false,
  label = 'Entrar no Discord',
  href = links.discord,
} = Astro.props;
---

{href ? (
  <ButtonLink variant={secondary ? 'secondary' : 'primary'} href={href}>
    {label}
    <span aria-hidden="true">↗</span>
  </ButtonLink>
) : (
  <p class="notice">O convite para a comunidade será disponibilizado aqui.</p>
)}
