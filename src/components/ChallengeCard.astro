---
import type { CollectionEntry } from 'astro:content';
import { challengeLanguages } from '../lib/challenge-languages.mjs';
import { difficultyLabels } from '../lib/challenges';
interface Props {
  challenge: CollectionEntry<'challenges'>;
  headingLevel?: 'h2' | 'h3';
}
const { challenge, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = challenge;
---

<article class="challenge-card">
  <div class="challenge-info">
    <div class="challenge-meta">
      <span class="level">
        {difficultyLabels[data.difficulty]}
        {data.difficultyContext && ` (${data.difficultyContext})`}
      </span>
      <span
        class="mono"
        aria-label={`Linguagens: ${challengeLanguages(data).join(', ')}`}
      >
        {challengeLanguages(data).join(' · ')}
      </span>
    </div>
    <Heading class="challenge-title">
      <a href={`/desafios/${data.slug}`}>
        {data.title}
        <span class="accent" aria-hidden="true">
          _
        </span>
      </a>
    </Heading>
    <p>{data.summary}</p>
    {data.recommendedLanguage && challengeLanguages(data).length > 1 && (
      <p class="recommendation">Recomendação: {data.recommendedLanguage}</p>
    )}
    <div class="topics">
      {(data.cardTopics ?? data.topics.slice(0, 3)).map((topic) => (
        <span class="tag">{topic}</span>
      ))}
    </div>
    <span class="card-action" aria-hidden="true">
      Abrir enunciado <span>↗</span>
    </span>
  </div>
</article>
<style>
  .challenge-card {
    height: 100%;
    position: relative;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 160ms ease;
  }
  .challenge-card:is(:hover, :focus-within) {
    border-color: var(--color-accent);
  }
  .challenge-info {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 24px;
  }
  .challenge-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
    font-size: 13px;
    color: var(--color-muted);
    margin-bottom: 20px;
  }
  .level {
    color: var(--color-accent-text);
    border: 1px solid #71503d;
    padding: 3px 9px;
    border-radius: 3px;
    font: 12px/1.6 var(--font-mono);
  }
  .challenge-title {
    font-size: 28px;
    margin-bottom: 16px;
  }
  .challenge-title a {
    text-decoration: none;
  }
  .challenge-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .challenge-card:hover .challenge-title a {
    text-decoration: underline;
  }
  .recommendation {
    font-size: 12px;
    margin-top: 12px;
  }
  .tag {
    font-size: 12px;
  }

  p {
    font-size: 15px;
    max-width: 70ch;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 24px;
  }
  .card-action {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: 44px;
    font-size: 14px;
    color: var(--color-text);
    font-weight: 550;
    margin-top: auto;
    align-self: flex-start;
  }
</style>
