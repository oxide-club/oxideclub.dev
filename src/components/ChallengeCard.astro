---
import type { CollectionEntry } from 'astro:content';
import { difficultyLabels } from '../lib/challenges';
import { categoryLabels } from '../lib/challenge-taxonomy.mjs';
interface Props {
  challenge: CollectionEntry<'challenges'>;
  headingLevel?: 'h2' | 'h3';
}
const { challenge, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = challenge;
---

<article class="challenge-card">
  <div class="challenge-info">
    <div class="challenge-meta">
      <span class="level">{difficultyLabels[data.difficulty]}</span>
      <span class="mono">
        {data.recommendedLanguage && `${data.recommendedLanguage} / `}
        {data.participation === 'flagship'
          ? 'Desafio principal'
          : 'Exploração livre'}
      </span>
    </div>
    <Heading class="challenge-title">
      <a href={`/desafios/${data.slug}`}>
        {data.title}
        <span class="accent" aria-hidden="true">
          _
        </span>
      </a>
    </Heading>
    <p>{data.summary}</p>
    <p class="categories">
      Categorias:{' '}
      {data.categories.map((category) => categoryLabels[category]).join(' · ')}
    </p>
    <div class="topics">
      {data.topics.map((topic) => (
        <span class="tag">{topic}</span>
      ))}
    </div>
    <a class="text-link" href={`/desafios/${data.slug}`}>
      Ler o desafio completo <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
<style>
  .challenge-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .challenge-info {
    padding: 36px 40px;
  }
  .challenge-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    font-size: 11px;
    color: var(--color-muted);
    margin-bottom: 24px;
  }
  .level {
    color: var(--color-accent-text);
    border: 1px solid #71503d;
    padding: 3px 9px;
    border-radius: 3px;
    font: 11px var(--font-mono);
  }
  .challenge-title {
    font-size: 36px;
    margin-bottom: 16px;
  }
  .challenge-title a {
    text-decoration: none;
  }
  .challenge-title a:hover {
    text-decoration: underline;
  }
  p {
    font-size: 14px;
    max-width: 70ch;
  }
  .categories {
    margin-top: 16px;
    font-size: 12px;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 24px;
  }
  .text-link {
    color: var(--color-text);
    font-weight: 550;
  }
  @media (max-width: 700px) {
    .challenge-info {
      padding: 28px 24px;
    }
    .challenge-title {
      font-size: 30px;
    }
  }
</style>
