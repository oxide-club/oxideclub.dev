---
import type { CollectionEntry } from 'astro:content';
import { difficultyLabels } from '../lib/challenges';
interface Props {
  challenge: CollectionEntry<'challenges'>;
  headingLevel?: 'h2' | 'h3';
}
const { challenge, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = challenge;
---

<article class="challenge-card">
  <div class="challenge-info">
    <div class="challenge-meta">
      <span class="level">{difficultyLabels[data.difficulty]}</span>
      {data.recommendedLanguage && (
        <span class="mono">{data.recommendedLanguage}</span>
      )}
    </div>
    <Heading class="challenge-title">
      <a href={`/desafios/${data.slug}`}>
        {data.title}
        <span class="accent" aria-hidden="true">
          _
        </span>
      </a>
    </Heading>
    <p>{data.summary}</p>
    <div class="topics">
      {data.topics.map((topic) => (
        <span class="tag">{topic}</span>
      ))}
    </div>
    <a class="text-link" href={`/desafios/${data.slug}`}>
      Ler o desafio completo <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
<style>
  .challenge-card {
    height: 100%;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color 160ms ease;
  }
  .challenge-card:is(:hover, :focus-within) {
    border-color: var(--color-accent);
  }
  .challenge-info {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 28px 24px;
  }
  .challenge-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 12px;
    align-items: center;
    font-size: 11px;
    color: var(--color-muted);
    margin-bottom: 20px;
  }
  .level {
    color: var(--color-accent-text);
    border: 1px solid #71503d;
    padding: 3px 9px;
    border-radius: 3px;
    font: 11px var(--font-mono);
  }
  .challenge-title {
    font-size: 28px;
    margin-bottom: 16px;
  }
  .challenge-title a {
    text-decoration: none;
  }
  .challenge-title a:hover {
    text-decoration: underline;
  }
  p {
    font-size: 14px;
    max-width: 70ch;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 24px;
  }
  .text-link {
    color: var(--color-text);
    font-weight: 550;
    margin-top: auto;
    align-self: flex-start;
  }
</style>
