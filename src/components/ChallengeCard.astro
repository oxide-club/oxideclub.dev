---
import type { CollectionEntry } from 'astro:content';
import { difficultyLabels } from '../lib/challenges';
import { categoryLabels } from '../lib/challenge-taxonomy.mjs';
interface Props {
  challenge: CollectionEntry<'challenges'>;
  headingLevel?: 'h2' | 'h3';
}
const { challenge, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = challenge;
---

<article
  class:list={[
    'challenge-card',
    { 'without-example': data.slug !== 'recriando-wc' },
  ]}
>
  <div class="challenge-info">
    <div class="challenge-meta">
      <span class="level">{difficultyLabels[data.difficulty]}</span>
      <span class="mono">
        {data.recommendedLanguage && `${data.recommendedLanguage} / `}
        {data.participation === 'flagship'
          ? 'Desafio principal'
          : 'Exploração livre'}
      </span>
    </div>
    <Heading class="challenge-title">
      <a href={`/desafios/${data.slug}`}>
        {data.title}
        <span class="accent" aria-hidden="true">
          _
        </span>
      </a>
    </Heading>
    <p>{data.summary}</p>
    <p class="categories">
      Categorias:{' '}
      {data.categories.map((category) => categoryLabels[category]).join(' · ')}
    </p>
    <div class="topics">
      {data.topics.map((topic) => (
        <span class="tag">{topic}</span>
      ))}
    </div>
    <a class="text-link" href={`/desafios/${data.slug}`}>
      Ler o desafio completo <span aria-hidden="true">↗</span>
    </a>
  </div>
  {data.slug === 'recriando-wc' && (
    <div class="example">
      <div class="example-top">
        <span>EXPERIMENTO / ENTRADA E SAÍDA</span>
        <span aria-hidden="true">stdin → stdout</span>
      </div>
      <pre aria-label="Exemplo: contar uma linha, duas palavras e dez bytes"><code><span class="muted">$</span> printf 'ola mundo\n' | ./oxide-wc
<span class="result">1 2 10</span></code></pre>
      <div class="counts" aria-hidden="true">
        <span>
          01 <small>linha</small>
        </span>
        <span>
          02 <small>palavras</small>
        </span>
        <span>
          10 <small>bytes</small>
        </span>
      </div>
      <p>
        Streams, contagem e estado.
        <br />O que acontece entre a entrada e o resultado?
      </p>
    </div>
  )}
</article>
<style>
  .challenge-card.without-example {
    grid-template-columns: 1fr;
  }
  .challenge-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .challenge-info {
    padding: 36px 40px;
  }
  .challenge-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    font-size: 11px;
    color: var(--color-muted);
    margin-bottom: 24px;
  }
  .level {
    color: var(--color-accent-text);
    border: 1px solid #71503d;
    padding: 3px 9px;
    border-radius: 3px;
    font: 11px var(--font-mono);
  }
  .challenge-title {
    font-size: 36px;
    margin-bottom: 16px;
  }
  .challenge-title a {
    text-decoration: none;
  }
  .challenge-title a:hover {
    text-decoration: underline;
  }
  p {
    font-size: 14px;
    max-width: 420px;
  }
  .categories {
    margin-top: 16px;
    font-size: 12px;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 24px;
  }
  .text-link {
    color: var(--color-text);
    font-weight: 550;
  }
  .example {
    padding: 32px 36px;
    background: #1e2123;
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  .example-top {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    font: 9px var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
  pre {
    font: 14px/2 var(--font-mono);
    margin: 32px 0 24px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .muted {
    color: var(--color-muted);
  }
  .result {
    color: var(--color-accent-text);
  }
  .counts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
    font: 23px var(--font-mono);
  }
  .counts small {
    display: block;
    margin-top: 9px;
    font-size: 10px;
    color: var(--color-muted);
  }
  .example > p {
    font-size: 11px;
    margin-top: 26px;
  }
  @media (max-width: 700px) {
    .challenge-card {
      grid-template-columns: 1fr;
    }
    .challenge-info,
    .example {
      padding: 28px 24px;
    }
    .example {
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
    .challenge-title {
      font-size: 30px;
    }
    .example-top {
      flex-wrap: wrap;
    }
  }
</style>
