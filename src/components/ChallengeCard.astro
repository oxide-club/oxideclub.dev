---
import DifficultyBadge from './ui/DifficultyBadge.astro';
import type { CollectionEntry } from 'astro:content';
import { challengeLanguages } from '../lib/challenge-languages.mjs';
interface Props {
  challenge: CollectionEntry<'challenges'>;
  headingLevel?: 'h2' | 'h3';
}
const { challenge, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = challenge;
---

<article class="challenge-card">
  <div class="challenge-info">
    <div class="challenge-meta">
      <DifficultyBadge
        level={data.difficulty}
        context={data.difficultyContext}
        variant="badge"
      />
      <span
        class="mono"
        aria-label={`Linguagens: ${challengeLanguages(data).join(', ')}`}
      >
        {challengeLanguages(data).join(' · ')}
      </span>
    </div>
    <Heading class="challenge-title">
      <a href={`/desafios/${data.slug}`}>
        {data.title}
        <span class="accent" aria-hidden="true">
          _
        </span>
      </a>
    </Heading>
    <p>{data.summary}</p>
    {data.recommendedLanguage && challengeLanguages(data).length > 1 && (
      <p class="recommendation">Recomendação: {data.recommendedLanguage}</p>
    )}
    <div class="topics">
      {(data.cardTopics ?? data.topics.slice(0, 3)).map((topic) => (
        <span class="tag">{topic}</span>
      ))}
    </div>
    <span class="card-action" aria-hidden="true">
      Abrir enunciado <span>→</span>
    </span>
  </div>
</article>
<style>
  .challenge-card {
    height: 100%;
    position: relative;
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: border-color var(--motion-fast) var(--motion-easing);
  }
  .challenge-card:is(:hover, :focus-within) {
    border-color: var(--color-accent);
  }
  .challenge-info {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-7) var(--space-6);
  }
  .challenge-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: center;
    font-size: var(--text-sm);
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }
  .challenge-title {
    font-size: var(--text-section-title);
    margin-bottom: var(--space-4);
  }
  .challenge-title a {
    text-decoration: none;
  }
  .challenge-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .challenge-card:hover .challenge-title a {
    text-decoration: underline;
  }
  .recommendation {
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  .tag {
    font-size: var(--text-sm);
  }

  p {
    font-size: var(--text-summary);
    max-width: 70ch;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-6);
  }
  .card-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--control-height);
    font-size: var(--text-control);
    color: var(--color-text);
    font-weight: 550;
    margin-top: auto;
    align-self: flex-start;
  }
  :global(.catalogue[data-view='list']) .challenge-info {
    padding: var(--space-5) var(--space-6);
  }
  :global(.catalogue[data-view='list']) .challenge-meta {
    margin-bottom: var(--space-3);
  }
  :global(.catalogue[data-view='list']) .challenge-title {
    font-size: var(--text-card-title);
    margin-bottom: var(--space-2);
  }
  :global(.catalogue[data-view='list']) .topics {
    margin-block: var(--space-4) var(--space-2);
  }
  @media (min-width: 900px) {
    :global(.catalogue[data-view='list']) .challenge-info {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(180px, 30%);
      column-gap: var(--space-8);
      align-content: start;
    }
    :global(.catalogue[data-view='list']) .challenge-info > * {
      grid-column: 1;
    }
    :global(.catalogue[data-view='list']) .challenge-info > .challenge-meta {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: start;
      justify-content: flex-end;
    }
    :global(.catalogue[data-view='list']) .challenge-title {
      grid-row: 1;
    }
    :global(.catalogue[data-view='list']) .challenge-info > p {
      grid-row: 2;
    }
    :global(.catalogue[data-view='list']) .challenge-info > .recommendation {
      grid-row: 3;
    }
    :global(.catalogue[data-view='list']) .topics {
      grid-row: 4;
    }
    :global(.catalogue[data-view='list']) .challenge-info > .card-action {
      grid-column: 2;
      grid-row: 3 / 5;
      justify-self: end;
      align-self: end;
    }
  }
</style>
