---
import type { CollectionEntry } from 'astro:content';
import { labUrl } from '../lib/lab-urls.mjs';
import { difficultyLabels } from '../lib/challenge-catalogue.mjs';
interface Props {
  lab: CollectionEntry<'labs'>;
}
const { lab } = Astro.props;
const title = lab.data.title.replace(/^Laboratório de /, '');
---

<article class="lab-card" data-lab>
  <div class="lab-heading">
    <h3>
      <a href={labUrl(lab.id)}>{title}</a>
    </h3>
    <span class="difficulty">{difficultyLabels[lab.data.difficulty]}</span>
  </div>
  <p>{lab.data.question}</p>
  <a
    class="text-link"
    href={labUrl(lab.id)}
    aria-label={`Explorar laboratório: ${title}`}
  >
    Explorar laboratório <span aria-hidden="true">→</span>
  </a>
</article>
<style>
  .lab-card {
    padding-block: 24px;
    border-bottom: 1px solid var(--color-border);
    min-width: 0;
  }
  .lab-card:first-child {
    padding-top: 0;
  }
  .lab-card:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .lab-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
  }
  h3 {
    font-size: 19px;
    line-height: 1.4;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  .difficulty {
    font: 12px/1.6 var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
  }
  p {
    font-size: 15px;
    margin-block: 12px;
    max-width: 68ch;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
  }
  @media (max-width: 650px) {
    .lab-heading {
      display: block;
    }
    h3 a {
      display: inline-block;
      min-height: 44px;
      align-content: center;
    }
    .difficulty {
      display: block;
      margin-top: 8px;
    }
  }
</style>
