---
import TextLink from './ui/TextLink.astro';
import DifficultyBadge from './ui/DifficultyBadge.astro';
import type { CollectionEntry } from 'astro:content';
import { labUrl } from '../lib/lab-urls.mjs';
interface Props {
  lab: CollectionEntry<'labs'>;
}
const { lab } = Astro.props;
const title = lab.data.title.replace(/^Laboratório de /, '');
---

<article class="lab-card" data-lab>
  <div class="lab-heading">
    <h3>
      <a href={labUrl(lab.id)}>{title}</a>
    </h3>
    <DifficultyBadge level={lab.data.difficulty} />
  </div>
  <p>{lab.data.question}</p>
  <TextLink href={labUrl(lab.id)} aria-label={`Explorar laboratório: ${title}`}>
    Explorar laboratório <span aria-hidden="true">→</span>
  </TextLink>
</article>
<style>
  .lab-card {
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    min-width: 0;
  }
  .lab-card:first-child {
    padding-top: 0;
  }
  .lab-card:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .lab-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-5);
  }
  h3 {
    font-size: var(--text-item-title);
    line-height: 1.4;
  }
  h3 a {
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  p {
    font-size: var(--text-summary);
    margin-block: var(--space-3);
    max-width: 68ch;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-height);
    font-size: var(--text-control);
  }
  @media (max-width: 650px) {
    .lab-heading :global(.difficulty) {
      display: block;
      margin-top: var(--space-2);
    }
    .lab-heading {
      display: block;
    }
    h3 a {
      display: inline-block;
      min-height: var(--control-height);
      align-content: center;
    }
  }
</style>
