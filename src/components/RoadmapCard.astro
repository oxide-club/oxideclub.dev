---
interface Props { roadmap: Awaited<ReturnType<typeof import('../lib/roadmaps').publishedRoadmaps>>[number] }
const {roadmap}=Astro.props;
const {data}=roadmap;
---
<article class="roadmap-card" data-roadmap-card>
  <p class="eyebrow">{data.featured?'Em destaque':'Roadmap'}</p>
  <h2><a href={`/roadmaps/${roadmap.id}/`}>{data.title}</a></h2>
  <p>{data.summary}</p>
  <div class="entry"><h3>Conhecimentos de entrada</h3><p>{data.prerequisites.join(' ')||'Nenhum conhecimento prévio declarado.'}</p></div>
  <p class="count">{data.nodes.length} materiais · Explorar roadmap <span aria-hidden="true">→</span></p>
</article>
<style>
 .roadmap-card{display:flex;flex-direction:column;gap:var(--space-4);border:1px solid var(--color-border);border-radius:var(--radius-control);padding:var(--space-6);min-width:0}
 h2{font-size:var(--text-card-title);line-height:1.3}h2 a{text-decoration:none}h2 a:hover{text-decoration:underline}p{font-size:var(--text-summary);color:var(--color-prose)}.eyebrow,.count{color:var(--color-accent-text)}.entry h3{font-size:var(--text-sm);margin-bottom:var(--space-2)}.entry p{font-size:var(--text-sm);color:var(--color-muted)}.count{margin-top:auto;padding-top:var(--space-3);font-size:var(--text-control)}
</style>
