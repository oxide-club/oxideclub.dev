---
import JoinLink from './JoinLink.astro';
const pathname = decodeURI(Astro.url.pathname);
const navigation = [
  { label: 'Início', href: '/' },
  { label: 'Desafios', href: '/desafios' },
  { label: 'Laboratórios', href: '/labs/' },
  { label: 'Roadmaps', href: '/roadmaps/' },
  { label: 'Notas', href: '/notas/' },
  { label: 'Biblioteca', href: '/biblioteca' },
  { label: 'Como participar', href: '/como-participar/' },
];
---

<header class="container header">
  <a class="wordmark" href="/" aria-label="Oxide Club — início">
    <img src="/branding/oxide-core.svg" alt="" width="44" height="44" />
    <span class="brand-name">Oxide Club</span>
  </a>
  <nav aria-label="Navegação principal" class="desktop-nav">
    {navigation.map(({ label, href }) => (
      <a
        href={href}
        aria-current={
          (
            href === '/'
              ? pathname === '/'
              : pathname.startsWith(href.replace(/\/$/, ''))
          )
            ? 'page'
            : undefined
        }
      >
        {label}
      </a>
    ))}
  </nav>
  <div class="header-join">
    <JoinLink />
  </div>
  <details class="mobile-nav">
    <summary>
      Menu <span class="menu-symbol" aria-hidden="true"></span>
    </summary>
    <nav aria-label="Navegação móvel">
      {navigation.map(({ label, href }) => (
        <a
          href={href}
          aria-current={
            (
              href === '/'
                ? pathname === '/'
                : pathname.startsWith(href.replace(/\/$/, ''))
            )
              ? 'page'
              : undefined
          }
        >
          {label}
        </a>
      ))}
      <JoinLink />
    </nav>
  </details>
</header>
<script>
  document.querySelectorAll('.mobile-nav a').forEach((link) =>
    link.addEventListener('click', () => {
      const details = link.closest('details');
      if (details) details.open = false;
    }),
  );
  document
    .querySelector('.mobile-nav')
    ?.addEventListener('keydown', (event) => {
      if ((event as KeyboardEvent).key === 'Escape') {
        const details = event.currentTarget as HTMLDetailsElement;
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });
</script>
<style>
  .header {
    min-height: 100px;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    flex-wrap: wrap;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    position: relative;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--control-height);
    font-size: 25px;
    font-weight: 600;
    letter-spacing: -1px;
    text-decoration: none;
    white-space: nowrap;
  }
  .wordmark img {
    flex-shrink: 0;
  }
  @media (max-width: 380px) {
    .wordmark {
      gap: var(--space-2);
      font-size: 22px;
    }
    .wordmark img {
      width: 36px;
      height: 36px;
    }
  }
  .desktop-nav {
    margin-left: auto;
    display: flex;
    gap: var(--space-8);
  }
  .desktop-nav > a {
    font-size: var(--text-sm);
    text-decoration: none;
    min-height: var(--control-height);
    display: flex;
    align-items: center;
  }
  .desktop-nav > a:hover,
  .desktop-nav > a[aria-current] {
    text-decoration: underline;
  }
  .header-join :global(.button) {
    min-height: 40px;
    font-size: var(--text-sm);
    padding: 10px var(--space-4);
  }
  .mobile-nav {
    display: none;
  }
  .menu-symbol::before {
    content: '+';
  }
  .mobile-nav[open] .menu-symbol::before {
    content: '−';
  }
  @media (max-width: 1080px) {
    .desktop-nav {
      gap: var(--space-5);
    }
    .header {
      gap: 18px;
    }
  }
  @media (max-width: 1050px) {
    .header {
      min-height: 80px;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .desktop-nav,
    .header-join {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .mobile-nav summary {
      list-style: none;
      cursor: pointer;
      font-size: var(--text-control);
      min-height: var(--control-height);
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }
    .mobile-nav nav {
      position: absolute;
      z-index: 5;
      top: 100%;
      left: 0;
      right: 0;
      padding: var(--space-6);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .mobile-nav nav > a {
      padding: 10px 0;
    }
    .mobile-nav nav :global(.button) {
      margin-top: var(--space-2);
    }
  }
</style>
