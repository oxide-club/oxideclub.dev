---
import ButtonLink from './ui/ButtonLink.astro';
import { labAssetUrl, labPackageUrl } from '../lib/lab-urls.mjs';
interface Props {
  labId: string;
  files: Array<{ path: string; type: string }>;
}
const { labId, files } = Astro.props;
---

<div class="materials-download">
  <ButtonLink href={labPackageUrl(labId)} download>
    Baixar materiais <span aria-hidden="true">↓</span>
  </ButtonLink>
  <details>
    <summary>Arquivos do laboratório</summary>
    <ul>
      {files
        .filter((f) => f.path !== 'index.md')
        .map((file) => (
          <li>
            <a href={labAssetUrl(labId, file.path)}>{file.path}</a>
          </li>
        ))}
    </ul>
  </details>
</div>
<style>
  .materials-download {
    margin-top: var(--space-6);
  }
  details {
    margin-top: var(--space-4);
    max-width: 70ch;
  }
  summary {
    cursor: pointer;
    min-height: var(--control-height);
    display: list-item;
    padding-block: 10px;
    font-size: var(--text-control);
  }
  ul {
    padding-left: var(--space-5);
  }
  li {
    margin: var(--space-2) 0;
    font: 13px var(--font-mono);
    overflow-wrap: anywhere;
  }
  a {
    overflow-wrap: anywhere;
  }
</style>
