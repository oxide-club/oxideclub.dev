---
import type { CollectionEntry } from 'astro:content';
import {
  challengeSearchText,
  difficultyLabels,
} from '../lib/challenge-catalogue.mjs';
interface Props {
  challenges: CollectionEntry<'challenges'>[];
  areas: import('../lib/challenge-areas.mjs').Area[];
}
const { challenges, areas } = Astro.props;
const areaFor = (id: string) => areas.find((area) => area.id === id)!;
---

<div data-challenge-list>
  <form
    class="catalogue-filters"
    role="search"
    aria-label="Buscar desafios"
    hidden
  >
    <label class="query-field">
      Buscar desafios
      <input
        name="q"
        type="search"
        placeholder="Título, número ou assunto"
        autocomplete="off"
        aria-controls="challenge-table"
      />
    </label>
    <label>
      <span id="challenge-area-label">Área</span>
      <select
        name="area"
        aria-labelledby="challenge-area-label"
        aria-controls="challenge-table"
      >
        <option value="">Todas as áreas</option>
        {areas.map((area) => (
          <option value={area.id}>{area.title}</option>
        ))}
      </select>
    </label>
    <label>
      <span id="challenge-difficulty-label">Dificuldade</span>
      <select
        name="difficulty"
        aria-labelledby="challenge-difficulty-label"
        aria-controls="challenge-table"
      >
        <option value="">Todos os níveis</option>
        {Object.entries(difficultyLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </select>
    </label>
    <button type="reset">Limpar filtros</button>
  </form>
  <div class="results-line">
    <p role="status" aria-live="polite" aria-atomic="true" data-result-count>
      {challenges.length} desafios
    </p>
    <div class="mobile-sort" data-script-controls hidden>
      <label>
        Ordenar
        <select name="sort">
          <option value="number">Número</option>
          <option value="title">Título</option>
          <option value="difficulty">Dificuldade</option>
        </select>
      </label>
      <button type="button" data-sort-direction aria-label="Ordem decrescente">
        ↓
      </button>
    </div>
    <span class="pace">Explore no seu ritmo.</span>
  </div>
  <table id="challenge-table">
    <caption class="sr-only">
      Desafios publicados por número, título, área e dificuldade
    </caption>
    <thead>
      <tr>
        <th scope="col" data-sort-heading="number" aria-sort="ascending">
          <span data-sort-fallback>Nº</span>
          <button type="button" data-sort="number" aria-label="Número" hidden>
            Nº <span aria-hidden="true">↑</span>
          </button>
        </th>
        <th scope="col" data-sort-heading="title">
          <span data-sort-fallback>Desafio</span>
          <button type="button" data-sort="title" aria-label="Título" hidden>
            Desafio <span aria-hidden="true">↕</span>
          </button>
        </th>
        <th scope="col" class="desktop-meta">
          Área
        </th>
        <th scope="col" class="desktop-meta" data-sort-heading="difficulty">
          <span data-sort-fallback>Dificuldade</span>
          <button
            type="button"
            data-sort="difficulty"
            aria-label="Ordenar por dificuldade"
            hidden
          >
            Dificuldade <span aria-hidden="true">↕</span>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {challenges.map((challenge) => {
        const { id, data } = challenge;
        const area = areaFor(data.area);
        return (
          <tr
            data-challenge
            data-id={id}
            data-title={data.title}
            data-area={area.id}
            data-difficulty={data.difficulty}
            data-search={challengeSearchText(challenge, area.title)}
          >
            <td class="challenge-number">{id.slice(0, 3)}</td>
            <td class="challenge-title">
              <a href={`/desafios/${data.slug}`}>{data.title}</a>
              <div class="mobile-meta">
                <span>{area.title}</span>
                <span class="difficulty" data-level={data.difficulty}>
                  {difficultyLabels[data.difficulty]}
                </span>
              </div>
            </td>
            <td class="desktop-meta area-name">{area.title}</td>
            <td class="desktop-meta">
              <span class="difficulty" data-level={data.difficulty}>
                {difficultyLabels[data.difficulty]}
              </span>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <div class="empty-results" hidden>
    <h2>Nenhum desafio encontrado.</h2>
    <p>Tente outro termo ou remova os filtros.</p>
    <button type="button" data-clear-filters>
      Limpar filtros
    </button>
  </div>
</div>
<script>
  import '../scripts/challenge-list';
</script>
<style>
  [hidden] {
    display: none !important;
  }
  .catalogue-filters {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(
        0,
        0.8fr
      ) auto;
    gap: 16px;
    align-items: end;
    padding-block: 28px 20px;
  }
  label {
    display: grid;
    gap: 8px;
    min-width: 0;
    font-size: 13px;
    color: var(--color-muted);
  }
  input,
  select {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 10px 12px;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font: inherit;
    font-size: 14px;
  }
  input::placeholder {
    color: var(--color-muted);
  }
  input:focus-visible,
  select:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
  button {
    min-height: 44px;
    color: var(--color-muted);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }
  button:hover {
    color: var(--color-accent-text);
  }
  button[type='reset'] {
    padding: 10px 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .results-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-block: 20px;
    font-size: 13px;
    color: var(--color-muted);
  }
  .catalogue-filters:not([hidden]) + .results-line {
    padding-top: 0;
  }
  .pace {
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .mobile-sort {
    display: none;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
    font-size: 14px;
  }
  th {
    font-weight: 400;
    color: var(--color-muted);
    padding: 6px 14px;
    border-block: 1px solid var(--color-border);
    font-size: 12px;
  }
  th:first-child {
    width: 8%;
    padding-left: 0;
  }
  th:nth-child(2) {
    width: 43%;
  }
  th:nth-child(3) {
    width: 30%;
  }
  th:nth-child(4) {
    width: 19%;
  }
  th button {
    padding: 0;
    text-align: left;
    font-size: 12px;
  }
  th button span {
    color: var(--color-accent-text);
    margin-left: 6px;
  }
  td {
    padding: 14px;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  .challenge-number {
    padding-left: 0;
    color: var(--color-muted);
    font: 12px var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .challenge-title a {
    font-weight: 500;
    text-decoration: none;
  }
  .challenge-title a:hover {
    text-decoration: underline;
  }
  .area-name {
    font-size: 12px;
    color: var(--color-muted);
  }
  .difficulty {
    font: 12px/1.6 var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
  }
  .difficulty[data-level='beginner'] {
    color: var(--color-accent-text);
  }
  tbody tr:hover {
    background: var(--color-surface);
  }
  .mobile-meta {
    display: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .empty-results {
    padding: 48px 16px;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }
  .empty-results h2 {
    font-size: 24px;
  }
  .empty-results p {
    margin-block: 12px 20px;
  }
  .empty-results button {
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 10px 16px;
    color: var(--color-text);
    background: var(--color-surface);
  }
  @media (max-width: 650px) {
    .catalogue-filters {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 12px;
      padding-block: 24px 16px;
    }
    .query-field,
    button[type='reset'] {
      grid-column: 1/-1;
    }
    button[type='reset'] {
      justify-self: end;
    }
    input,
    select {
      font-size: 16px;
      padding-inline: 8px;
    }
    .pace {
      display: none;
    }
    .mobile-sort {
      display: flex;
      align-items: end;
      gap: 8px;
    }
    .mobile-sort label {
      gap: 4px;
      font-size: 12px;
    }
    .mobile-sort select {
      width: 110px;
      font-size: 13px;
    }
    .mobile-sort button {
      width: 44px;
      border: 1px solid var(--color-border);
      border-radius: 4px;
      background: var(--color-surface);
    }
    th:first-child {
      width: 14%;
    }
    th:nth-child(2) {
      width: 86%;
      padding-left: 4px;
    }
    .desktop-meta {
      display: none;
    }
    td {
      padding: 16px 4px;
    }
    .challenge-number {
      vertical-align: top;
      padding-top: 20px;
    }
    .mobile-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
      color: var(--color-muted);
      font-size: 12px;
      margin-top: 8px;
    }
  }
</style>
