---
import Input from './ui/Input.astro';
import Button from './ui/Button.astro';
import Select from './ui/Select.astro';
import DifficultyBadge from './ui/DifficultyBadge.astro';
import type { CollectionEntry } from 'astro:content';
import {
  challengeSearchText,
  difficultyLabels,
} from '../lib/challenge-catalogue.mjs';
interface Props {
  challenges: CollectionEntry<'challenges'>[];
  areas: import('../lib/challenge-areas.mjs').Area[];
}
const { challenges, areas } = Astro.props;
const areaFor = (id: string) => areas.find((area) => area.id === id)!;
---

<div data-challenge-list>
  <form
    class="catalogue-filters"
    role="search"
    aria-label="Buscar desafios"
    hidden
  >
    <label class="query-field">
      Buscar desafios
      <Input
        name="q"
        type="search"
        placeholder="Título, número ou assunto"
        autocomplete="off"
        aria-controls="challenge-table"
      />
    </label>
    <label>
      <span id="challenge-area-label">Área</span>
      <Select
        name="area"
        aria-labelledby="challenge-area-label"
        aria-controls="challenge-table"
      >
        <option value="">Todas as áreas</option>
        {areas.map((area) => (
          <option value={area.id}>{area.title}</option>
        ))}
      </Select>
    </label>
    <label>
      <span id="challenge-difficulty-label">Dificuldade</span>
      <Select
        name="difficulty"
        aria-labelledby="challenge-difficulty-label"
        aria-controls="challenge-table"
      >
        <option value="">Todos os níveis</option>
        {Object.entries(difficultyLabels).map(([value, label]) => (
          <option value={value}>{label}</option>
        ))}
      </Select>
    </label>
    <Button type="reset" variant="quiet">
      Limpar filtros
    </Button>
  </form>
  <div class="results-line">
    <p role="status" aria-live="polite" aria-atomic="true" data-result-count>
      {challenges.length} desafios
    </p>
    <div class="mobile-sort" data-script-controls hidden>
      <label>
        Ordenar
        <Select name="sort">
          <option value="number">Número</option>
          <option value="title">Título</option>
          <option value="difficulty">Dificuldade</option>
        </Select>
      </label>
      <button type="button" data-sort-direction aria-label="Ordem decrescente">
        ↓
      </button>
    </div>
    <span class="pace">Explore no seu ritmo.</span>
  </div>
  <table id="challenge-table">
    <caption class="sr-only">
      Desafios publicados por número, título, área e dificuldade
    </caption>
    <thead>
      <tr>
        <th scope="col" data-sort-heading="number" aria-sort="ascending">
          <span data-sort-fallback>Nº</span>
          <button type="button" data-sort="number" aria-label="Número" hidden>
            Nº <span aria-hidden="true">↑</span>
          </button>
        </th>
        <th scope="col" data-sort-heading="title">
          <span data-sort-fallback>Desafio</span>
          <button type="button" data-sort="title" aria-label="Título" hidden>
            Desafio <span aria-hidden="true">↕</span>
          </button>
        </th>
        <th scope="col" class="desktop-meta">
          Área
        </th>
        <th scope="col" class="desktop-meta" data-sort-heading="difficulty">
          <span data-sort-fallback>Dificuldade</span>
          <button
            type="button"
            data-sort="difficulty"
            aria-label="Ordenar por dificuldade"
            hidden
          >
            Dificuldade <span aria-hidden="true">↕</span>
          </button>
        </th>
      </tr>
    </thead>
    <tbody>
      {challenges.map((challenge) => {
        const { id, data } = challenge;
        const area = areaFor(data.area);
        return (
          <tr
            data-challenge
            data-id={id}
            data-title={data.title}
            data-area={area.id}
            data-difficulty={data.difficulty}
            data-search={challengeSearchText(challenge, area.title)}
          >
            <td class="challenge-number">{id.slice(0, 3)}</td>
            <td class="challenge-title">
              <a href={`/desafios/${data.slug}`}>{data.title}</a>
              <dl class="mobile-meta">
                <div>
                  <dt class="sr-only">Área</dt>
                  <dd>{area.title}</dd>
                </div>
                <div>
                  <dt class="sr-only">Dificuldade</dt>
                  <dd>
                    <DifficultyBadge level={data.difficulty} />
                  </dd>
                </div>
              </dl>
            </td>
            <td class="desktop-meta area-name">{area.title}</td>
            <td class="desktop-meta">
              <DifficultyBadge level={data.difficulty} />
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <div class="empty-results" hidden>
    <h2>Nenhum desafio encontrado.</h2>
    <p>Tente outro termo ou remova os filtros.</p>
    <Button variant="quiet" data-clear-filters>
      Limpar filtros
    </Button>
  </div>
</div>
<script>
  import '../scripts/challenge-list';
</script>
<style>
  [hidden] {
    display: none !important;
  }
  .catalogue-filters {
    display: grid;
    grid-template-columns:
      minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 0.8fr)
      auto;
    gap: var(--space-4);
    align-items: end;
    padding-block: var(--space-7) var(--space-5);
  }
  label {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  button:not(.button) {
    min-height: var(--control-height);
    color: var(--color-muted);
    background: transparent;
    border: 0;
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }
  button:not(.button):hover {
    color: var(--color-accent-text);
  }
  .results-line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-block: var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .catalogue-filters:not([hidden]) + .results-line {
    padding-top: 0;
  }
  .pace {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .mobile-sort {
    display: none;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
    text-align: left;
    font-size: var(--text-control);
  }
  th {
    font-weight: 400;
    color: var(--color-muted);
    padding: 6px 14px;
    border-block: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }
  th:first-child {
    width: 8%;
    padding-left: 0;
  }
  th:nth-child(2) {
    width: 43%;
  }
  th:nth-child(3) {
    width: 30%;
  }
  th:nth-child(4) {
    width: 19%;
  }
  th button {
    padding: 0;
    text-align: left;
    font-size: var(--text-xs);
  }
  th button span {
    color: var(--color-accent-text);
    margin-left: 6px;
  }
  td {
    padding: 14px;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  .challenge-number {
    padding-left: 0;
    color: var(--color-muted);
    font: 12px var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .challenge-title a {
    display: inline-block;
    min-height: 24px;
    font-weight: 500;
    text-decoration: none;
  }
  .challenge-title a:hover {
    text-decoration: underline;
  }
  .area-name {
    font-size: var(--text-xs);
    color: var(--color-muted);
  }
  tbody tr:hover {
    background: var(--color-surface);
  }
  .mobile-meta {
    display: none;
  }
  .mobile-meta dd {
    margin: 0;
  }
  .mobile-meta > div {
    min-width: 0;
  }
  .empty-results {
    padding: var(--space-12) var(--space-4);
    text-align: center;
    border-bottom: 1px solid var(--color-border);
  }
  .empty-results h2 {
    font-size: var(--text-card-title);
  }
  .empty-results p {
    margin-block: var(--space-3) var(--space-5);
  }
  @media (max-width: 650px) {
    .challenge-title a {
      min-height: var(--control-height);
      align-content: center;
    }
    .catalogue-filters {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-3);
      padding-block: var(--space-6) var(--space-4);
    }
    .query-field,
    button[type='reset'] {
      grid-column: 1/-1;
    }
    button[type='reset'] {
      justify-self: end;
    }
    .pace {
      display: none;
    }
    .mobile-sort {
      display: flex;
      align-items: end;
      gap: var(--space-2);
    }
    .mobile-sort label {
      gap: var(--space-1);
      font-size: var(--text-xs);
    }
    .mobile-sort select {
      width: 110px;
      font-size: var(--text-sm);
    }
    .mobile-sort button {
      width: 44px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-control);
      background: var(--color-surface);
    }
    th:first-child {
      width: 14%;
    }
    th:nth-child(2) {
      width: 86%;
      padding-left: var(--space-1);
    }
    .desktop-meta {
      display: none;
    }
    td {
      padding: var(--space-4) var(--space-1);
    }
    .challenge-number {
      vertical-align: top;
      padding-top: var(--space-5);
    }
    .mobile-meta {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-3);
      color: var(--color-muted);
      font-size: var(--text-xs);
      margin: var(--space-2) 0 0;
    }
  }
</style>
