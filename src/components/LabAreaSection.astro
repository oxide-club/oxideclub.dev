---
import CatalogueSection from './ui/CatalogueSection.astro';
import type { CollectionEntry } from 'astro:content';
import LabCard from './LabCard.astro';
interface Props {
  area: import('../lib/content-areas.mjs').Area;
  labs: CollectionEntry<'labs'>[];
}
const { area, labs } = Astro.props;
---

<CatalogueSection
  area={area}
  count={labs.length}
  singular="LABORATÓRIO"
  plural="LABORATÓRIOS"
  data-lab-area
>
  {labs.map((lab) => (
    <LabCard lab={lab} />
  ))}
</CatalogueSection>
