---
import ButtonLink from './ui/ButtonLink.astro';
import type { CommunityImplementation } from '../lib/community';
import { githubUrl } from '../config/github.mjs';
import JoinLink from './JoinLink.astro';
interface Props {
  implementations: CommunityImplementation[];
  discordThreadUrl?: string;
}
const { implementations, discordThreadUrl } = Astro.props;
const contributeUrl = `${githubUrl('solutions', 'CONTRIBUTING.md', 'blob')}#compartilhar-uma-implementação`;
const statusLabels = { completed: 'Concluída', partial: 'Parcial' };
---

<section
  class="community-implementations"
  aria-labelledby="community-implementations-heading"
>
  <h2 id="community-implementations-heading">Implementações da comunidade</h2>
  {implementations.length > 0 && (
    <>
      <p class="community-context">
        Código e estados declarados pelos participantes, sem garantia de
        correção, segurança, desempenho ou conclusão pelo clube.
      </p>
      <ul class="community-list">
        {implementations.map((implementation) => (
          <li>
            <div class="implementation-meta">
              <span class="implementation-author">
                {implementation.authorUrl ? (
                  <a href={implementation.authorUrl}>{implementation.author}</a>
                ) : (
                  implementation.author
                )}
              </span>
              <span class="implementation-language">
                {implementation.language}
              </span>
              <span class="implementation-status">
                {statusLabels[implementation.status]}
              </span>
            </div>
            {implementation.notes && (
              <p class="implementation-notes">{implementation.notes}</p>
            )}
            <a
              class="implementation-source"
              href={implementation.url}
              aria-label={`Código-fonte de ${implementation.author} em ${implementation.language}`}
            >
              Código-fonte <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
  <p class="participation-note">
    Converse sobre sua solução no Discord, mesmo que ela ainda esteja em
    desenvolvimento. Para incluir uma implementação neste catálogo, publique o
    código em um repositório público seu e siga o guia de contribuição no
    GitHub.
  </p>
  <div class="actions community-actions">
    <JoinLink
      href={discordThreadUrl}
      label="Conversar sobre a solução no Discord"
    />
    <ButtonLink variant="secondary" href={contributeUrl}>
      Compartilhe sua implementação <span aria-hidden="true">↗</span>
    </ButtonLink>
  </div>
  <p class="participation-note writing-invitation">
    Encontrou algo que vale explicar? Sua investigação pode virar uma nota para
    o site do clube, mesmo sem concluir o desafio.
    <a href="/notas/#contribuir">
      Como propor um texto <span aria-hidden="true">→</span>
    </a>
  </p>
</section>
<style>
  .community-implementations {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }
  .community-implementations h2 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-card-title);
  }
  .community-context,
  .implementation-notes {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-control);
  }
  .community-list {
    list-style: none;
    padding: 0;
    margin: 18px 0 var(--space-2);
  }
  .community-list li {
    margin: 0;
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    overflow-wrap: anywhere;
  }
  .implementation-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-control);
  }
  .implementation-author {
    font-weight: 600;
  }
  .implementation-language,
  .implementation-status {
    font: 13px var(--font-mono);
    color: var(--color-muted);
  }
  .community-implementations a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--control-height);
  }
  .implementation-source {
    margin-top: var(--space-2);
  }
  .participation-note {
    font-size: var(--text-control);
  }
  .community-actions :global(.button) {
    color: var(--color-on-accent);
    text-align: center;
  }
  .community-actions .secondary {
    color: var(--color-text);
  }
</style>
