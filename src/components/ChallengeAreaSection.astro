---
import type { CollectionEntry } from 'astro:content';
import DifficultyBadge from './ui/DifficultyBadge.astro';
import CatalogueSection from './ui/CatalogueSection.astro';
interface Props {
  area: import('../lib/challenge-areas.mjs').Area;
  challenges: CollectionEntry<'challenges'>[];
}
const { area, challenges } = Astro.props;
---

<CatalogueSection
  area={area}
  count={challenges.length}
  singular="DESAFIO"
  plural="DESAFIOS"
  data-area-section
>
  {challenges.map(({ data }) => (
    <article data-challenge>
      <div class="challenge-heading">
        <h3>
          <a href={`/desafios/${data.slug}`}>
            {data.title}
            <span aria-hidden="true"> ↗</span>
          </a>
        </h3>
        <DifficultyBadge level={data.difficulty} />
      </div>
      <p>{data.summary}</p>
    </article>
  ))}
</CatalogueSection>
<style>
  article {
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }
  article:first-child {
    padding-top: 0;
  }
  article:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .challenge-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-5);
  }
  h3 {
    font-size: var(--text-item-title);
    line-height: 1.4;
  }
  h3 a {
    display: inline-block;
    min-height: 24px;
    text-decoration: none;
  }
  h3 a:hover {
    text-decoration: underline;
  }
  h3 span {
    color: var(--color-accent-text);
    font-size: var(--text-sm);
  }
  article p {
    font-size: var(--text-control);
    margin-top: var(--space-2);
    max-width: var(--reading-width);
  }
  @media (max-width: 650px) {
    .challenge-heading :global(.difficulty) {
      display: block;
      margin-top: var(--space-2);
    }
    h3 a {
      min-height: var(--control-height);
      align-content: center;
    }
    .challenge-heading {
      display: block;
    }
  }
</style>
