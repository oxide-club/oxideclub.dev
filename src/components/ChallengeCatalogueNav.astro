---
interface Props {
  active: 'areas' | 'list';
  areaCount: number;
  challengeCount: number;
}
const { active, areaCount, challengeCount } = Astro.props;
---

<nav id="catalogue-top" aria-label="Explorar desafios" class="catalogue-nav">
  <a href="/desafios" aria-current={active === 'areas' ? 'page' : undefined}>
    Por área <span>{String(areaCount).padStart(2, '0')}</span>
  </a>
  <a
    href="/desafios/lista"
    aria-current={active === 'list' ? 'page' : undefined}
  >
    Lista <span>{String(challengeCount).padStart(2, '0')}</span>
  </a>
</nav>
<style>
  .catalogue-nav {
    display: flex;
    gap: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: var(--space-6);
  }
  a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 52px;
    padding: var(--space-3) 0;
    border-bottom: 2px solid transparent;
    text-decoration: none;
    font-size: var(--text-summary);
    color: var(--color-muted);
  }
  a[aria-current] {
    border-color: var(--color-accent-text);
    color: var(--color-text);
  }
  span {
    font: 12px var(--font-mono);
    color: var(--color-muted);
  }
</style>
