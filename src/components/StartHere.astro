---
import JoinLink from './JoinLink.astro';
---

<section
  class="section start-here"
  id="como-participar"
  aria-labelledby="start-heading"
>
  <div class="section-heading">
    <div>
      <div class="eyebrow">Como participar</div>
      <h2 id="start-heading">O que você está construindo ou estudando?</h2>
    </div>
    <p>
      Traga uma dúvida, uma ideia de projeto ou algo que esteja estudando. Você
      também pode começar acompanhando as conversas.
    </p>
  </div>
  <JoinLink />
</section>

<style>
  .section-heading > div {
    min-width: 0;
    max-width: 580px;
  }
  .section-heading > p {
    flex-shrink: 0;
  }
</style>
