---
import JoinLink from './JoinLink.astro';
---

<section
  class="section start-here"
  id="como-participar"
  aria-labelledby="start-heading"
>
  <div class="section-heading">
    <div>
      <div class="eyebrow">Como participar</div>
      <h2 id="start-heading">Comece por uma conversa.</h2>
    </div>
    <p>
      No #comece-aqui do Discord, conheça os espaços do clube. Acompanhe as
      conversas e participe quando se sentir à vontade.
    </p>
  </div>
  <JoinLink />
</section>

<style>
  .section-heading > div {
    min-width: 0;
    max-width: 580px;
  }
  .section-heading > p {
    flex-shrink: 0;
  }
</style>
