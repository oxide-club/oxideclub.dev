---
import TextLink from '../../components/ui/TextLink.astro';
import ReadingLayout from '../../components/ui/ReadingLayout.astro';
import { render, getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { join } from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabIndex from '../../components/LabIndex.astro';
import LabMaterials from '../../components/LabMaterials.astro';
import JoinLink from '../../components/JoinLink.astro';
import { publishedLabs } from '../../lib/labs';
import { labsDirectory } from '../../lib/lab-source.mjs';
import { labFiles } from '../../lib/lab-files.mjs';
import { labUrl } from '../../lib/lab-urls.mjs';
import { difficultyLabels } from '../../lib/challenges';
export async function getStaticPaths() {
  return (await publishedLabs()).map((lab) => ({
    params: { slug: lab.id },
    props: { lab },
  }));
}
interface Props {
  lab: CollectionEntry<'labs'>;
}
const { lab } = Astro.props;
const { data } = lab;
const { Content, headings } = await render(lab);
const links = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ href: '#' + h.slug, text: h.text }));
const files = await labFiles(join(labsDirectory(), lab.id));
const related = [
  ...(await publishedLabs())
    .filter((x) => data.relatedLabs.includes(x.id))
    .map((x) => ({ title: x.data.title, url: labUrl(x.id) })),
  ...(await getCollection('challenges'))
    .filter((x) => data.relatedChallenges.includes(x.id) && !x.data.draft)
    .map((x) => ({ title: x.data.title, url: '/desafios/' + x.id + '/' })),
];
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="container">
    <header class="page-intro">
      <TextLink href={labUrl()}>← Todos os laboratórios</TextLink>
      <div class="eyebrow">
        Etapas obrigatórias · Nível{' '}
        {difficultyLabels[data.difficulty].toLowerCase()}
      </div>
      <h1>
        {data.title}
        <span class="accent">_</span>
      </h1>
      <p class="central-question">{data.question}</p>
      <p>{data.summary}</p>
      <div class="metadata">
        <span>{data.environment}</span>
        <span>
          Publicado em{' '}
          {data.publishedAt!.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
        </span>
        {data.updatedAt && (
          <span>
            Atualizado em{' '}
            {data.updatedAt.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
          </span>
        )}
      </div>
      <LabMaterials labId={lab.id} files={files} />
    </header>
    <ReadingLayout label="Neste laboratório" variant="lab">
      <LabIndex links={links} slot="index" />
      <Content />
      {related.length > 0 && (
        <div class="related">
          <p>
            <strong>Continue a investigação</strong>
          </p>
          <ul>
            {related.map((item) => (
              <li>
                <a href={item.url}>{item.title}</a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </ReadingLayout>
    <div class="conversation">
      <JoinLink
        href={data.discordThreadUrl}
        label="Conversar sobre a investigação"
      />
    </div>
  </div>
</BaseLayout>
<style>
  .page-intro {
    padding-block: var(--space-10);
  }
  .page-intro > .text-link {
    margin-bottom: var(--space-6);
  }
  .page-intro h1 {
    max-width: 24ch;
    font-size: clamp(34px, 5vw, 52px);
    margin: var(--space-5) 0;
  }
  .page-intro p {
    max-width: 70ch;
    margin-top: var(--space-4);
  }
  .central-question {
    font-size: 22px;
    color: var(--color-text);
  }
  .metadata {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    font: 12px/1.7 var(--font-mono);
    color: var(--color-muted);
    margin-top: var(--space-5);
  }
  .conversation {
    padding-block: var(--space-6) var(--space-16);
    border-top: 1px solid var(--color-border);
  }
  :global(.prose details) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    margin-block: var(--space-6);
  }
  :global(.prose details summary) {
    cursor: pointer;
    color: var(--color-text);
    min-height: var(--control-height);
    padding: 10px 0;
  }
  :global(.prose h3) {
    scroll-margin-top: var(--space-6);
  }
  .related {
    margin-bottom: var(--space-6);
  }
</style>
