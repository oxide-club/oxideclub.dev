---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabAreaSection from '../../components/LabAreaSection.astro';
import { loadAreas } from '../../lib/content-areas.mjs';
import { labsDirectory } from '../../lib/lab-source.mjs';
import { groupLabsByArea } from '../../lib/lab-catalogue.mjs';
import { publishedLabs } from '../../lib/labs';
const labs = await publishedLabs();
const groups = groupLabsByArea(labs, await loadAreas(labsDirectory()));
---

<BaseLayout
  title="Laboratórios"
  description="Faça experimentos nos laboratórios do Oxide Club. Escreva código. Explique os resultados. Aprenda como os programas funcionam."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Laboratórios · Aprenda com experimentos</div>
      <h1>
        Uma pergunta.
        <br />
        Vários experimentos.
      </h1>
      <p>
        Escolha uma área e investigue uma pergunta sobre computação. Faça os
        experimentos, registre suas observações e explique os resultados.
      </p>
      <p class="method">
        Prever <span aria-hidden="true">→</span> Observar{' '}
        <span aria-hidden="true">→</span> Explicar{' '}
        <span aria-hidden="true">→</span> Implementar ou corrigir{' '}
        <span aria-hidden="true">→</span> Verificar
      </p>
    </header>
    {groups.length > 0 && (
      <nav class="area-index" aria-label="Áreas dos laboratórios">
        {groups.map(({ area, labs }) => (
          <a href={`#${area.slug}`}>
            {area.title}
            <span>
              {String(labs.length).padStart(2, '0')}{' '}
              <span aria-hidden="true">↓</span>
            </span>
          </a>
        ))}
      </nav>
    )}
    <div class="catalogue">
      {labs.length ? (
        groups.map((group) => <LabAreaSection {...group} />)
      ) : (
        <p>
          Ainda não há laboratórios publicados. Novas investigações aparecerão
          aqui.
        </p>
      )}
    </div>
    <section class="participation">
      <h2>O que você descobriu?</h2>
      <p>
        Compartilhe o que você tentou e o que observou. Inclua os comandos
        usados e sua explicação. Você pode participar com o código ainda
        incompleto.
      </p>
      <a class="text-link" href="/como-participar/">
        Como participar do clube →
      </a>
      <p>
        Para resolver atividades com objetivos definidos, consulte o{' '}
        <a href="/desafios/">catálogo de desafios</a>.
      </p>
    </section>
  </div>
</BaseLayout>
<style>
  .page-intro {
    padding-block: 48px 32px;
  }
  .page-intro h1 {
    font-size: clamp(34px, 5vw, 56px);
    margin: 20px 0;
  }
  .page-intro p {
    max-width: 68ch;
  }
  .method {
    font: 13px/2 var(--font-mono);
    color: var(--color-accent-text);
    margin-top: 24px;
  }
  .method span {
    padding-inline: 5px;
  }
  .area-index {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 28px;
    padding-block: 20px 28px;
  }
  .area-index > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 60px;
    border-bottom: 1px solid var(--color-border);
    font-size: 14px;
    text-decoration: none;
  }
  .area-index > a:hover {
    text-decoration: underline;
  }
  .area-index > a > span {
    font: 12px var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
  }
  @media (max-width: 650px) {
    .area-index {
      grid-template-columns: minmax(0, 1fr);
    }
    .area-index > a {
      min-height: 48px;
    }
  }
  .catalogue {
    padding-bottom: 24px;
  }
  .participation {
    padding: 32px 0 64px;
    border-top: 1px solid var(--color-border);
  }
  .participation h2 {
    font-size: 28px;
  }
  .participation p {
    max-width: 68ch;
    margin: 20px 0;
  }
</style>
