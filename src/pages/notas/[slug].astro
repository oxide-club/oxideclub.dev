---
import { render } from 'astro:content';
import { githubUrl } from '../../config/github.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedNotes, noteDate } from '../../lib/notes';
export async function getStaticPaths() {
  return (await publishedNotes()).map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}
interface Props {
  note: Awaited<ReturnType<typeof publishedNotes>>[number];
}
const { note } = Astro.props;
const { data } = note;
const { Content, headings } = await render(note);
const sections = headings.filter(({ depth }) => depth === 2);
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="container">
    <article class="note">
      <header class="page-intro">
        <a class="text-link" href="/notas">
          ← Todas as notas
        </a>
        <div class="eyebrow">Caderno técnico / Oxide Club</div>
        <h1>{data.title}</h1>
        <p>{data.summary}</p>
        <div class="metadata">
          {data.authors && <p>Por {data.authors.join(' · ')}</p>}
          <p>
            Publicado em{' '}
            <time datetime={data.publishedAt.toISOString()}>
              {noteDate(data.publishedAt)}
            </time>
          </p>
          {data.updatedAt && (
            <p>
              Atualizado em{' '}
              <time datetime={data.updatedAt.toISOString()}>
                {noteDate(data.updatedAt)}
              </time>
            </p>
          )}
        </div>
      </header>
      {sections.length > 0 && (
        <nav class="contents" aria-label="Nesta nota">
          <span class="eyebrow">Nesta nota</span>
          <ul>
            {sections.map(({ slug, text }) => (
              <li>
                <a href={`#${slug}`}>{text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      <div class="prose note-body">
        <Content />
      </div>
      <footer class="note-footer">
        <a
          class="text-link"
          href={githubUrl('notes', `${note.id}/index.md`, 'blob')}
        >
          Ver no GitHub <span aria-hidden="true">↗</span>
        </a>
        <p>
          Texto disponível sob{' '}
          <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>,
          salvo indicação em contrário. Preserve a atribuição aos autores.
          Código e materiais de terceiros podem ter licenças próprias, indicadas
          na fonte.
        </p>
        <p>Você também pode escrever sobre algo que estudou ou experimentou.</p>
        <a class="text-link" href="/notas/#contribuir">
          Como contribuir com uma nota <span aria-hidden="true">→</span>
        </a>
        <a class="text-link" href="/notas">
          ← Voltar ao caderno
        </a>
      </footer>
    </article>
  </div>
</BaseLayout>
<style>
  .note {
    max-width: 76ch;
    margin-inline: auto;
  }
  .page-intro > .text-link {
    margin-bottom: 28px;
  }
  .metadata {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    font: 12px/1.6 var(--font-mono);
  }
  .contents {
    padding-block: 24px;
    border-block: 1px solid var(--color-border);
  }
  .contents ul {
    list-style: none;
    padding: 0;
    margin: 16px 0 0;
  }
  .contents a {
    display: inline-block;
    padding-block: 8px;
    font-size: 14px;
  }
  .note-body {
    max-width: none;
    padding-top: 16px;
    line-height: 1.8;
  }
  .note-body :global(blockquote) {
    margin: 28px 0;
    border-left: 2px solid var(--color-accent);
    padding-left: 24px;
  }
  .note-body :global(figure) {
    margin: 32px 0;
  }
  .note-body :global(figure img) {
    display: block;
    margin-inline: auto;
  }
  .note-body :global(figcaption) {
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 12px;
  }
  .note-body :global(hr) {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin-block: 40px;
  }
  .note-body :global(h4),
  .note-body :global(h5),
  .note-body :global(h6) {
    line-height: 1.4;
    margin-block: 24px 12px;
  }
  .note-body :global(.footnotes) {
    font-size: 14px;
    border-top: 1px solid var(--color-border);
    margin-top: 40px;
  }
  .note-footer > p {
    margin-block: 16px;
  }
  .note-footer > .text-link {
    display: flex;
    width: fit-content;
  }
  .note-footer {
    margin-top: 48px;
    padding-block: 24px 64px;
    border-top: 1px solid var(--color-border);
  }
</style>
