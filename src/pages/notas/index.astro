---
import TextLink from '../../components/ui/TextLink.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import { githubUrl, repositoryUrl } from '../../config/github.mjs';
import { links } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedNotes, noteDate } from '../../lib/notes';
const notes = await publishedNotes();
---

<BaseLayout
  title="Notas e textos técnicos"
  description="Notas e textos de quem participa do Oxide Club sobre computação, com foco em sistemas. Leia e saiba como propor seu texto pelo GitHub."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Oxide Club / Caderno técnico</div>
      <h1>
        Notas e textos técnicos
        <span class="accent" aria-hidden="true">
          _
        </span>
      </h1>
      <p>
        Textos de quem participa do Oxide Club sobre computação, com foco em
        sistemas. Explicações, relatos de experimentos e investigações que podem
        ser aprofundados e revisados pela comunidade.
      </p>
    </header>
    <section class="notebook" aria-labelledby="notes-heading">
      <h2 id="notes-heading">Publicações</h2>
      {notes.length ? (
        <ol class="notes-list">
          {notes.map(({ id, data }) => (
            <li>
              <article>
                <time datetime={data.publishedAt.toISOString()}>
                  {noteDate(data.publishedAt)}
                </time>
                <h3>
                  <a href={`/notas/${id}`}>{data.title}</a>
                </h3>
                <p>{data.summary}</p>
                {data.topics.length > 0 && (
                  <p class="topics">
                    {data.topics.map((topic) => (
                      <span class="tag">{topic}</span>
                    ))}
                  </p>
                )}
                {data.authors && (
                  <p class="authors">{data.authors.join(' · ')}</p>
                )}
                <TextLink href={`/notas/${id}`}>
                  Ler nota <span aria-hidden="true">→</span>
                  <span class="sr-only">: {data.title}</span>
                </TextLink>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-note">
          <h3>As primeiras notas estão por vir</h3>
          <p>
            Ainda não há notas publicadas. Você pode contribuir com as
            primeiras: escreva sobre uma pergunta que investigou, um conceito
            que estudou ou um experimento que realizou.
          </p>
          <TextLink href="#contribuir">
            Como enviar seu texto <span aria-hidden="true">→</span>
          </TextLink>
        </div>
      )}
    </section>
    <section
      class="contribution"
      id="contribuir"
      aria-labelledby="contribution-heading"
      tabindex="-1"
    >
      <h2 id="contribution-heading">Escreva para o Oxide Club</h2>
      <p>
        Compartilhe uma explicação, uma comparação de abordagens ou um relato de
        experimento. Você pode escrever mesmo começando os estudos.
      </p>
      <ol class="writing-steps">
        <li>
          Use o{' '}
          <a href={githubUrl('notes', 'templates/note.md', 'blob')}>
            modelo de nota
          </a>{' '}
          para organizar seu texto e informar a autoria.
        </li>
        <li>
          Envie um pull request (uma proposta de contribuição) no repositório{' '}
          <a href={repositoryUrl('notes')}>oxide-club/notes</a>.
        </li>
        <li>
          Acompanhe a revisão no GitHub e ajuste o texto com os comentários
          recebidos.
        </li>
      </ol>
      <p>
        Enviar ou incorporar uma proposta não significa publicação imediata. O
        texto passa por revisão e validação; rascunhos ficam fora do site até
        estarem prontos. O guia explica as etapas e como discutir ideias para
        artigos mais longos.
      </p>
      <div class="actions">
        <ButtonLink href={githubUrl('notes', 'CONTRIBUTING.md', 'blob')}>
          Ver como contribuir no GitHub <span aria-hidden="true">↗</span>
        </ButtonLink>
        <TextLink href={repositoryUrl('notes')}>
          Ver o repositório de notas <span aria-hidden="true">↗</span>
        </TextLink>
      </div>
      {links.discord && (
        <p class="optional-support">
          Quer conversar sobre uma ideia ou precisa de ajuda para começar? Você
          também pode procurar a comunidade no{' '}
          <a href={links.discord}>Discord</a>. Esse apoio é opcional: você pode
          abrir seu PR diretamente no GitHub.
        </p>
      )}
    </section>
  </div>
</BaseLayout>
<style>
  .contribution {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-10) var(--space-20);
    max-width: 76ch;
  }
  .contribution h2 {
    margin-bottom: var(--space-6);
  }
  .contribution p + p {
    margin-top: var(--space-4);
  }
  .writing-steps {
    color: var(--color-muted);
    padding-left: var(--space-6);
    margin-block: var(--space-4);
  }
  .writing-steps a {
    display: inline-block;
    min-height: 24px;
  }
  .writing-steps li + li {
    margin-top: var(--space-2);
  }
  .contribution .actions {
    margin-top: var(--space-6);
  }
  .contribution .optional-support {
    margin-top: var(--space-6);
    font-size: var(--text-control);
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .notebook {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-10) var(--space-20);
  }
  .notebook > h2 {
    font-size: var(--text-card-title);
    margin-bottom: var(--space-8);
  }
  .empty-note {
    border-left: 2px solid var(--color-accent);
    padding: var(--space-2) 0 var(--space-2) var(--space-6);
    max-width: 68ch;
  }
  h3 {
    margin-bottom: var(--space-4);
  }
  .empty-note p {
    margin-bottom: var(--space-4);
  }
  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 76ch;
  }
  .notes-list li + li {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-7);
    padding-top: var(--space-7);
  }
  time {
    display: block;
    font: 13px var(--font-mono);
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }
  h3 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color var(--motion-fast) var(--motion-easing),
      text-decoration-color var(--motion-fast) var(--motion-easing);
  }
  h3 a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
  .authors {
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  .text-link {
    margin-top: var(--space-3);
  }
  @media (forced-colors: active) {
    h3 a {
      text-decoration-color: LinkText;
    }
  }
</style>
