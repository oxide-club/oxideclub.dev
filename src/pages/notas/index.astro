---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedNotes, noteDate } from '../../lib/notes';
const notes = await publishedNotes();
---

<BaseLayout
  title="Notas técnicas"
  description="O caderno técnico público do Oxide Club: artigos, notas de laboratório e experimentos sobre modelos, algoritmos, protocolos e sistemas de computação."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Oxide Club / Caderno técnico</div>
      <h1>
        Notas técnicas
        <span class="accent" aria-hidden="true">
          _
        </span>
      </h1>
      <p>
        Um espaço para registrar como chegamos a uma conclusão: o código, os
        testes, as referências e as perguntas que continuam abertas.
      </p>
    </header>
    <section class="notebook" aria-labelledby="notes-heading">
      <h2 id="notes-heading">Publicações</h2>
      {notes.length ? (
        <ol class="notes-list">
          {notes.map(({ id, data }) => (
            <li>
              <article>
                <time datetime={data.publishedAt.toISOString()}>
                  {noteDate(data.publishedAt)}
                </time>
                <h3>
                  <a href={`/notas/${id}`}>{data.title}</a>
                </h3>
                <p>{data.summary}</p>
                {data.topics.length > 0 && (
                  <p class="topics">
                    {data.topics.map((topic) => (
                      <span class="tag">{topic}</span>
                    ))}
                  </p>
                )}
                {data.authors && (
                  <p class="authors">{data.authors.join(' · ')}</p>
                )}
                <a class="text-link" href={`/notas/${id}`}>
                  Ler nota <span aria-hidden="true">↗</span>
                  <span class="sr-only">: {data.title}</span>
                </a>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <div class="empty-note">
          <h3>Ainda não há notas publicadas.</h3>
          <p>
            Este caderno reunirá artigos técnicos, notas de laboratório e
            relatos de experimentos. Enquanto isso, os desafios já estão abertos
            para leitura e prática.
          </p>
          <a class="text-link" href="/desafios">
            Explorar os desafios <span aria-hidden="true">↗</span>
          </a>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
<style>
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
  }
  .notebook {
    border-top: 1px solid var(--color-border);
    padding-block: 40px 80px;
  }
  .notebook > h2 {
    font-size: 24px;
    margin-bottom: 32px;
  }
  .empty-note {
    border-left: 2px solid var(--color-accent);
    padding: 8px 0 8px 24px;
    max-width: 68ch;
  }
  h3 {
    margin-bottom: 16px;
  }
  .empty-note p {
    margin-bottom: 16px;
  }
  .notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 76ch;
  }
  .notes-list li + li {
    border-top: 1px solid var(--color-border);
    margin-top: 28px;
    padding-top: 28px;
  }
  time {
    display: block;
    font: 12px var(--font-mono);
    color: var(--color-muted);
    margin-bottom: 16px;
  }
  h3 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }
  h3 a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
  .authors {
    font-size: 13px;
    margin-top: 12px;
  }
  .text-link {
    margin-top: 12px;
  }
  @media (forced-colors: active) {
    h3 a {
      text-decoration-color: LinkText;
    }
  }
</style>
