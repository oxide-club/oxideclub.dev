---
import TextLink from '../components/ui/TextLink.astro';
import ButtonLink from '../components/ui/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinLink from '../components/JoinLink.astro';
import StartHere from '../components/StartHere.astro';
import FeaturedContent from '../components/FeaturedContent.astro';
import RecentPublications from '../components/RecentPublications.astro';
import { publishedContent } from '../lib/publications';
import { selectHomePublications } from '../lib/publication-catalogue.mjs';
import home from '../config/home.json';
import { publishedMeetings } from '../lib/meetings';
const meetings = await publishedMeetings();
const { featured, recent } = selectHomePublications(
  await publishedContent(),
  home.featured,
);
const exploreHref = featured.length
  ? '#destaques'
  : recent.length
    ? '#recentes'
    : '/labs/';
---

<BaseLayout description="Oxide Club: clube de computação com foco em sistemas. Estude C, Rust, arquitetura de computadores e sistemas operacionais em comunidade.">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow">Clube de computação com foco em sistemas</div>
        <h1 id="hero-title">
          Entenda como o software <span>realmente funciona.</span>
        </h1>
        <p>
          Estude C, Rust e sistemas construindo pequenos programas e discutindo
          suas descobertas com a comunidade.
        </p>
        <div class="actions">
          <ButtonLink href={exploreHref}>
            Explorar os materiais <span aria-hidden="true">↓</span>
          </ButtonLink>
          <JoinLink secondary />
        </div>
        <p>
          <TextLink href="/labs/">Conheça os laboratórios →</TextLink>
        </p>
        <div class="hero-note">
          <span aria-hidden="true">↳</span> Online, gratuito e aberto a
          iniciantes.
        </div>
      </div>
      <aside
        class="byte-study"
        aria-label="Um olhar sobre os bytes da palavra curiosidade"
      >
        <div class="study-label">
          <span>FIG. 01</span>
          <span>UM OLHAR MAIS DE PERTO</span>
        </div>
        <div class="word">
          <span class="sr-only">curiosidade</span>
          <span aria-hidden="true">
            {[...'curiosidade'].map((letter, index) => (
              <span
                data-letter={index}
                data-active={index === 0 ? '' : undefined}
              >
                {letter}
              </span>
            ))}
          </span>
          <span class="cursor" aria-hidden="true">
            _
          </span>
        </div>
        <div class="byte-bracket" aria-hidden="true"></div>
        <div class="hex-grid" aria-label="Bytes ASCII em hexadecimal">
          {[
            '63',
            '75',
            '72',
            '69',
            '6F',
            '73',
            '69',
            '64',
            '61',
            '64',
            '65',
            '0A',
          ].map((byte, index) => (
            <button
              type="button"
              class:list={['byte', { newline: index === 11 }]}
              data-index={index}
              data-active={index === 0 ? '' : undefined}
              aria-describedby={`byte-binary-${index}`}
              data-hex={byte}
              style={`--byte-delay: ${index * 65}ms`}
              aria-label={`${index === 11 ? 'Fim de linha LF' : `Letra ${'curiosidade'[index]}, posição ${index + 1}`}: hexadecimal ${byte}`}
            >
              <span>{byte}</span>
              <small>{index === 11 ? '\\n' : 'curiosidade'[index]}</small>
              <span class="sr-only" id={`byte-binary-${index}`}>
                Binário: {parseInt(byte, 16).toString(2).padStart(8, '0')}.
              </span>
            </button>
          ))}
        </div>
        <p class="byte-instruction">
          Explore os bytes com o ponteiro, toque ou teclado.
        </p>
        <div class="binary byte-readout" aria-hidden="true">
          c → 0x63 → 01100011
        </div>
        <div class="study-bottom">
          <span>11 caracteres ASCII + quebra de linha (LF) = 12 bytes.</span>
          <span>ASCII / HEX</span>
        </div>
      </aside>
    </section>
    <FeaturedContent publications={featured} />
    <RecentPublications publications={recent} />
    <section class="section" id="o-clube" aria-labelledby="club-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">O clube</div>
          <h2 id="club-heading">O que acontece no clube</h2>
        </div>
        <p>
          No Discord, compartilhamos perguntas, leituras e tentativas para
          investigar como os programas e os computadores funcionam.
        </p>
      </div>
      <div class="study-topics">
        <h3 id="study-topics-heading">O que estudamos</h3>
        <ul aria-labelledby="study-topics-heading" role="list">
          <li>Memória</li>
          <li>Processos</li>
          <li>Arquitetura</li>
          <li>Compiladores</li>
          <li>Sistemas operacionais</li>
        </ul>
      </div>
      <div class="club-paths">
        <article>
          <h3>Desafios</h3>
          <p>
            Construa pequenos programas, teste seu comportamento e compare
            abordagens com outras pessoas.
          </p>
          <TextLink href="/desafios">
            Explorar os desafios <span aria-hidden="true">→</span>
          </TextLink>
        </article>
        <article>
          <h3>Laboratórios</h3>
          <p>
            Siga roteiros de experimentos, observe o comportamento dos sistemas
            e compartilhe suas descobertas com a comunidade.
          </p>
          <TextLink href="/labs/">
            Explorar os laboratórios <span aria-hidden="true">→</span>
          </TextLink>
        </article>
        <article>
          <h3>Estudos e discussões</h3>
          <p>
            Traga uma referência ou uma pergunta e investigue um assunto com a
            comunidade.
          </p>
          <TextLink href="/biblioteca">
            Explorar a biblioteca <span aria-hidden="true">→</span>
          </TextLink>
        </article>
        <article>
          <h3>Notas e textos técnicos</h3>
          <p>
            Escreva sobre algo que estudou, implementou ou investigou. Quem
            participa do clube pode contribuir com textos para o site, com
            crédito de autoria.
          </p>
          <TextLink href="/notas/#contribuir">
            Como contribuir com um texto <span aria-hidden="true">→</span>
          </TextLink>
        </article>
      </div>
      <p class="club-planning">
        <TextLink href="/encontros/">
          {meetings.length
            ? 'Conheça os encontros do clube'
            : 'Conheça os encontros em preparação'}{' '}
          <span aria-hidden="true">→</span>
        </TextLink>
      </p>
    </section>
    <StartHere />
  </div>
</BaseLayout>
<script>
  const study = document.querySelector<HTMLElement>('.byte-study');
  if (study) {
    const bytes = [...study.querySelectorAll<HTMLButtonElement>('.byte')];
    const letters = [...study.querySelectorAll<HTMLElement>('[data-letter]')];
    const readout = study.querySelector<HTMLElement>('.byte-readout')!;
    let demonstrated = bytes[0];
    let hovered: HTMLButtonElement | null = null;
    const update = () => {
      const active =
        hovered ??
        bytes.find((byte) => byte === document.activeElement) ??
        demonstrated;
      bytes.forEach((byte) =>
        byte.toggleAttribute('data-active', byte === active),
      );
      letters.forEach((letter) =>
        letter.toggleAttribute(
          'data-active',
          letter.dataset.letter === active?.dataset.index,
        ),
      );
      const index = Number(active.dataset.index);
      const hex = active.dataset.hex!;
      readout.textContent = `${index === 11 ? 'LF' : 'curiosidade'[index]} → 0x${hex} → ${parseInt(hex, 16).toString(2).padStart(8, '0')}`;
      study.classList.add('inspected');
    };
    bytes.forEach((byte) => {
      byte.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        hovered = byte;
        update();
      });
      byte.addEventListener('pointerleave', () => {
        hovered = null;
        update();
      });
      byte.addEventListener('focus', () => {
        hovered = null;
        demonstrated = byte;
        update();
      });
      byte.addEventListener('blur', update);
      byte.addEventListener('click', () => {
        byte.focus();
        update();
      });
    });
  }
</script>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-12);
    align-items: center;
    padding-block: var(--space-16) var(--space-14);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > :is(h1, p, .actions) {
      animation: hero-enter 300ms ease-out backwards;
    }
    .hero-copy > p {
      animation-delay: 45ms;
    }
    .hero-copy > .actions {
      animation-delay: 90ms;
    }
    .hero-copy > .actions:focus-within {
      animation: none;
    }
  }
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero .eyebrow {
    font-size: var(--text-xs);
    margin-bottom: var(--space-7);
  }
  .hero h1 {
    font-size: clamp(42px, 5.2vw, 66px);
    letter-spacing: -0.06em;
    line-height: 1.1;
  }
  .hero h1 > span {
    color: var(--color-accent-text);
  }
  .hero-copy > p {
    font-size: var(--text-base);
    max-width: 510px;
    margin: var(--space-7) 0 var(--space-8);
    line-height: 1.75;
  }
  .hero-note {
    font: 13px/1.7 var(--font-mono);
    color: var(--color-muted);
    margin-top: 22px;
  }
  .hero-note > span {
    color: var(--color-accent-text);
    margin-right: 6px;
  }
  .byte-study {
    align-self: center;
    padding-top: 18px;
    min-width: 0;
  }
  .study-label,
  .study-bottom {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    font: 13px/1.6 var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }
  .word {
    font: 34px var(--font-mono);
    letter-spacing: -1.5px;
    padding: 38px 0 var(--space-6);
  }
  .cursor {
    color: var(--color-accent);
  }
  .byte-bracket {
    height: 16px;
    border: 1px solid var(--color-accent-border);
    border-bottom: 0;
    margin-bottom: var(--space-4);
  }
  .hex-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 7px;
  }
  .byte {
    border: 1px solid var(--color-border);
    padding: 10px 2px var(--space-2);
    text-align: center;
    background: #1c1f21;
    font: 16px var(--font-mono);
    color: var(--color-text);
    border-radius: 0;
    cursor: pointer;
    min-width: 0;
    animation: byte-scan 360ms ease-out var(--byte-delay) 1;
    transition:
      border-color var(--motion-fast) var(--motion-easing),
      background-color var(--motion-fast) var(--motion-easing),
      color var(--motion-fast) var(--motion-easing);
  }
  @keyframes byte-scan {
    45% {
      border-color: var(--color-accent);
      background-color: var(--color-highlight);
      color: var(--color-accent-text);
    }
  }
  .inspected .byte {
    animation: none;
  }
  .byte[data-active] {
    border-color: var(--color-accent);
    background-color: var(--color-highlight);
    color: var(--color-accent-text);
  }
  .word [data-letter] {
    transition:
      color var(--motion-fast) var(--motion-easing),
      background-color var(--motion-fast) var(--motion-easing);
  }
  .word [data-active] {
    color: var(--color-accent-text);
    background-color: var(--color-highlight);
    box-shadow: 0 2px var(--color-accent);
  }
  .byte small {
    display: block;
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-top: 7px;
  }
  .byte.newline {
    border-color: var(--color-accent-border);
    color: var(--color-accent-text);
    background: #28221e;
  }
  .byte-instruction {
    margin-top: 18px;
    font: 13px/1.6 var(--font-mono);
    text-align: center;
  }
  .binary {
    font: 13px/1.6 var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0;
    min-height: 2.5em;
    text-align: center;
    margin-block: 10px var(--space-6);
  }
  .study-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
    font-size: var(--text-sm);
  }
  .study-topics {
    margin-bottom: var(--space-8);
  }
  .study-topics h3 {
    font-size: var(--text-lead);
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }
  .study-topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .study-topics li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
    font-size: var(--text-summary);
  }
  .study-topics li::before {
    content: '';
    width: 5px;
    height: 5px;
    flex-shrink: 0;
    background: var(--color-accent);
    align-self: start;
    margin-top: 0.65em;
  }
  @media (forced-colors: active) {
    .study-topics li::before {
      background: CanvasText;
    }
  }
  .club-planning {
    max-width: 75ch;
    margin-top: var(--space-5);
    font-size: var(--text-control);
  }
  .club-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
  }
  .club-paths article {
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
  }
  .club-paths h3 {
    margin-bottom: var(--space-4);
  }
  .club-paths .text-link {
    margin-top: var(--space-4);
    font-size: var(--text-control);
  }
  .club-paths p {
    font-size: var(--text-control);
  }
  .section-heading > div {
    min-width: 0;
    max-width: 580px;
  }
  .section-heading > p {
    flex-shrink: 0;
  }
  .section > .actions {
    gap: var(--space-3) var(--space-7);
  }
  @media (max-width: 1000px) {
    .hero {
      gap: var(--space-8);
    }
    .hero h1 {
      font-size: 48px;
    }
    .word {
      font-size: var(--text-section-title);
    }
    .binary {
      letter-spacing: 0;
    }
  }
  @media (max-width: 700px) {
    .study-topics ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3) var(--space-5);
    }

    .club-paths {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
    .hero {
      grid-template-columns: 1fr;
      padding-block: var(--space-12);
      gap: 44px;
    }
    .hero h1 {
      font-size: clamp(37px, 8.5vw, 54px);
    }
    .hero .eyebrow {
      font-size: var(--text-xs);
      letter-spacing: 0.07em;
    }
    .hero-copy > p {
      font-size: var(--text-summary);
    }
    .byte-study {
      max-width: 460px;
      width: 100%;
    }
    .word {
      font-size: 32px;
      padding-top: var(--space-6);
    }
    .hex-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
