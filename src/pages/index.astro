---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinLink from '../components/JoinLink.astro';
import StartHere from '../components/StartHere.astro';
import { publishedChallenges } from '../lib/challenges';
const startingChallenge = (await publishedChallenges()).find(
  ({ id }) => id === '001-wc',
);
---

<BaseLayout>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow">Comunidade de programação de sistemas</div>
        <h1 id="hero-title">
          Entenda como o software <span>realmente funciona.</span>
        </h1>
        <p>
          Uma comunidade para estudar computação em conjunto e compartilhar o
          desenvolvimento de programas e projetos — das primeiras ideias às
          descobertas pelo caminho.
        </p>
        <div class="actions">
          <JoinLink />
          <a class="button secondary" href="/desafios">
            Conhecer os desafios <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-note">
          <span aria-hidden="true">↳</span> Participação online e gratuita. Quem
          está começando a estudar computação também é bem-vindo.
        </div>
      </div>
      <aside
        class="byte-study"
        aria-label="Um olhar sobre os bytes da palavra curiosidade"
      >
        <div class="study-label">
          <span>FIG. 01</span>
          <span>UM OLHAR MAIS DE PERTO</span>
        </div>
        <div class="word">
          <span class="sr-only">curiosidade</span>
          <span aria-hidden="true">
            {[...'curiosidade'].map((letter, index) => (
              <span data-letter={index}>{letter}</span>
            ))}
          </span>
          <span class="cursor" aria-hidden="true">
            _
          </span>
        </div>
        <div class="byte-bracket" aria-hidden="true"></div>
        <div class="hex-grid" aria-label="Bytes ASCII em hexadecimal">
          {[
            '63',
            '75',
            '72',
            '69',
            '6F',
            '73',
            '69',
            '64',
            '61',
            '64',
            '65',
            '0A',
          ].map((byte, index) => (
            <button
              type="button"
              class:list={['byte', { newline: index === 11 }]}
              data-index={index}
              data-hex={byte}
              style={`--byte-delay: ${index * 65}ms`}
              aria-label={`${index === 11 ? 'Fim de linha LF' : `Letra ${'curiosidade'[index]}, posição ${index + 1}`}: hexadecimal ${byte}`}
            >
              <span>{byte}</span>
              <small>{index === 11 ? '\\n' : 'curiosidade'[index]}</small>
            </button>
          ))}
        </div>
        <div class="binary byte-readout" aria-hidden="true">
          Toque ou selecione uma letra para ver seu byte.
        </div>
        <div class="study-bottom">
          <span>11 letras + quebra de linha (LF) = 12 bytes.</span>
          <span>ASCII / HEX</span>
        </div>
      </aside>
    </section>
    <div class="discipline-strip" aria-label="Áreas de interesse">
      <span>ASSUNTOS QUE NOS INTERESSAM</span>
      <ul>
        <li>Memória</li>
        <li>Processos</li>
        <li>Compiladores</li>
        <li>Sistemas operacionais</li>
      </ul>
      <span class="strip-plus" aria-hidden="true">
        +
      </span>
    </div>
    <section class="section" id="o-clube" aria-labelledby="club-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">O clube</div>
          <h2 id="club-heading">O que acontece no clube</h2>
        </div>
        <p>
          O clube está começando. No Discord, há espaço para compartilhar
          projetos, construir na companhia de outras pessoas e estudar junto.
        </p>
      </div>
      <div class="club-paths">
        <article>
          <p class="channel-label">Fórum · projetos</p>
          <h3>Compartilhe projetos</h3>
          <p>
            Abra um tópico para apresentar seu projeto e registrar avanços,
            decisões, dificuldades e descobertas. Ele pode estar nas primeiras
            ideias.
          </p>
        </article>
        <article>
          <p class="channel-label">Voz · build in public</p>
          <h3>Construa em público</h3>
          <p>
            Entre para programar na companhia de outras pessoas. Se quiser,
            compartilhe a tela e converse sobre o que está construindo.
          </p>
        </article>
        <article>
          <p class="channel-label">Voz · sala de estudos</p>
          <h3>Estude junto</h3>
          <p>
            Use a sala para estudar computação com outras pessoas, discutir
            referências e explorar dúvidas em conjunto.
          </p>
        </article>
      </div>
      <p class="club-invitation">
        Falar por voz e compartilhar a tela são opcionais. Você pode começar
        acompanhando, sem precisar ter algo pronto para mostrar.
      </p>
      <p class="club-planning">
        Notas técnicas, uma zine e os primeiros encontros estão nos planos do
        clube.
        <a class="text-link" href="/como-participar/#o-que-estamos-preparando">
          Veja o que estamos preparando <span aria-hidden="true">→</span>
        </a>
      </p>
    </section>
    {startingChallenge && (
      <section class="section" aria-labelledby="challenge-heading">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Uma ideia para começar</div>
            <h2 id="challenge-heading">
              Construa seu próprio <code>wc</code>
            </h2>
          </div>
          <p>
            Como um programa conta linhas, palavras e bytes? Implemente uma
            versão dessa ferramenta em C e explore leitura de dados e
            gerenciamento de estado.
          </p>
        </div>
        <div class="actions">
          <a class="text-link" href={`/desafios/${startingChallenge.id}`}>
            Ver o desafio <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/desafios">
            Ver todos os desafios <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}
    <section class="section learning" aria-labelledby="learning-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Nosso método</div>
          <h2 id="learning-heading">Explore. Experimente. Explique.</h2>
        </div>
        <p>
          Parta de uma pergunta, experimente uma ideia e compartilhe o que
          descobrir. Mostre também as tentativas, decisões e dúvidas enquanto
          estuda ou constrói.
        </p>
      </div>
    </section>
    <StartHere />
  </div>
</BaseLayout>
<script>
  const study = document.querySelector<HTMLElement>('.byte-study');
  if (study) {
    const bytes = [...study.querySelectorAll<HTMLButtonElement>('.byte')];
    const letters = [...study.querySelectorAll<HTMLElement>('[data-letter]')];
    const readout = study.querySelector<HTMLElement>('.byte-readout')!;
    const initial = readout.textContent;
    let hovered: HTMLButtonElement | null = null;
    const update = () => {
      const active =
        hovered ?? bytes.find((byte) => byte === document.activeElement);
      bytes.forEach((byte) =>
        byte.toggleAttribute('data-active', byte === active),
      );
      letters.forEach((letter) =>
        letter.toggleAttribute(
          'data-active',
          letter.dataset.letter === active?.dataset.index,
        ),
      );
      if (!active) {
        readout.textContent = initial;
        return;
      }
      const index = Number(active.dataset.index);
      const hex = active.dataset.hex!;
      readout.textContent = `${index === 11 ? 'LF' : 'curiosidade'[index]} → 0x${hex} → ${parseInt(hex, 16).toString(2).padStart(8, '0')}`;
      study.classList.add('inspected');
    };
    bytes.forEach((byte) => {
      byte.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        hovered = byte;
        update();
      });
      byte.addEventListener('pointerleave', () => {
        hovered = null;
        update();
      });
      byte.addEventListener('focus', update);
      byte.addEventListener('blur', update);
      byte.addEventListener('click', () => {
        byte.focus();
        update();
      });
    });
  }
</script>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 84px 72px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > :is(h1, p, .actions) {
      animation: hero-enter 300ms ease-out backwards;
    }
    .hero-copy > p {
      animation-delay: 45ms;
    }
    .hero-copy > .actions {
      animation-delay: 90ms;
    }
    .hero-copy > .actions:focus-within {
      animation: none;
    }
  }
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero .eyebrow {
    font-size: 10px;
    margin-bottom: 28px;
  }
  .hero h1 {
    font-size: clamp(42px, 5.2vw, 66px);
    letter-spacing: -0.06em;
    line-height: 1.1;
  }
  .hero h1 > span {
    color: var(--color-accent-text);
  }
  .hero-copy > p {
    font-size: 16px;
    max-width: 510px;
    margin: 28px 0 32px;
    line-height: 1.75;
  }
  .hero-note {
    font: 10px/1.7 var(--font-mono);
    color: var(--color-muted);
    margin-top: 22px;
  }
  .hero-note > span {
    color: var(--color-accent-text);
    margin-right: 6px;
  }
  .byte-study {
    align-self: center;
    padding-top: 18px;
    min-width: 0;
  }
  .study-label,
  .study-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 8px var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }
  .word {
    font: 34px var(--font-mono);
    letter-spacing: -1.5px;
    padding: 38px 0 24px;
  }
  .cursor {
    color: var(--color-accent);
  }
  .byte-bracket {
    height: 16px;
    border: 1px solid #71503d;
    border-bottom: 0;
    margin-bottom: 16px;
  }
  .hex-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 7px;
  }
  .byte {
    border: 1px solid var(--color-border);
    padding: 10px 2px 8px;
    text-align: center;
    background: #1c1f21;
    font: 16px var(--font-mono);
    color: var(--color-text);
    border-radius: 0;
    cursor: pointer;
    min-width: 0;
    animation: byte-scan 360ms ease-out var(--byte-delay) 1;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }
  @keyframes byte-scan {
    45% {
      border-color: var(--color-accent);
      background-color: #38271e;
      color: var(--color-accent-text);
    }
  }
  .inspected .byte {
    animation: none;
  }
  .byte[data-active] {
    border-color: var(--color-accent);
    background-color: #38271e;
    color: var(--color-accent-text);
  }
  .word [data-letter] {
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }
  .word [data-active] {
    color: var(--color-accent-text);
    background-color: #38271e;
    box-shadow: 0 2px var(--color-accent);
  }
  .byte small {
    display: block;
    color: var(--color-muted);
    font-size: 9px;
    margin-top: 7px;
  }
  .byte.newline {
    border-color: #71503d;
    color: var(--color-accent-text);
    background: #28221e;
  }
  .binary {
    font: 9px var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0;
    min-height: 2.5em;
    text-align: center;
    margin-block: 18px 28px;
  }
  .study-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
    font-size: 8px;
  }
  .discipline-strip {
    display: flex;
    align-items: center;
    gap: 32px;
    border-top: 1px solid var(--color-border);
    padding-block: 24px;
    font: 9px var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }
  .discipline-strip ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    color: var(--color-text);
    font-size: 11px;
  }
  .discipline-strip li::before {
    content: '/';
    color: #777e80;
    margin-right: 15px;
  }
  .strip-plus {
    font-size: 18px;
  }
  .club-invitation {
    max-width: 75ch;
    margin-top: 32px;
    font-size: 14px;
  }
  .club-planning {
    max-width: 75ch;
    margin-top: 20px;
    font-size: 14px;
  }
  .club-paths {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .club-paths article {
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }
  .club-paths .channel-label {
    font: 11px/1.6 var(--font-mono);
    margin-bottom: 16px;
  }
  .club-paths h3 {
    margin-bottom: 16px;
  }
  .club-paths p {
    font-size: 14px;
  }
  .section-heading > div {
    min-width: 0;
    max-width: 580px;
  }
  .section-heading > p {
    flex-shrink: 0;
  }
  .section > .actions {
    gap: 12px 28px;
  }
  .learning .section-heading {
    margin-bottom: 0;
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 32px;
    }
    .hero h1 {
      font-size: 48px;
    }
    .word {
      font-size: 28px;
    }
    .study-label {
      font-size: 7px;
    }
    .discipline-strip {
      gap: 20px;
    }
    .discipline-strip ul {
      gap: 12px;
    }
    .binary {
      letter-spacing: 0;
    }
  }
  @media (max-width: 700px) {
    .club-paths {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .hero {
      grid-template-columns: 1fr;
      padding-block: 48px;
      gap: 44px;
    }
    .hero h1 {
      font-size: clamp(37px, 8.5vw, 54px);
    }
    .hero .eyebrow {
      font-size: 9px;
      letter-spacing: 0.07em;
    }
    .hero-copy > p {
      font-size: 15px;
    }
    .hero-note {
      font-size: 10px;
    }
    .byte-study {
      max-width: 460px;
      width: 100%;
    }
    .study-label,
    .study-bottom {
      font-size: 9px;
    }
    .word {
      font-size: 32px;
      padding-top: 24px;
    }
    .hex-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .binary {
      font-size: 10px;
    }
    .discipline-strip {
      align-items: start;
      flex-direction: column;
      gap: 16px;
    }
    .discipline-strip ul {
      margin: 0;
      flex-wrap: wrap;
      gap: 12px 20px;
      font-size: 10px;
    }
    .discipline-strip li::before {
      margin-right: 8px;
    }
    .strip-plus {
      display: none;
    }
  }
</style>
