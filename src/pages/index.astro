---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinLink from '../components/JoinLink.astro';
import StartHere from '../components/StartHere.astro';
import { publishedMeetings } from '../lib/meetings';
import { publishedChallenges } from '../lib/challenges';
const meetings = await publishedMeetings();
const startingChallenge = (await publishedChallenges()).find(
  ({ id }) => id === '001-wc',
);
---

<BaseLayout description="Oxide Club: clube de computação com foco em sistemas. Estude C, Rust, arquitetura de computadores e sistemas operacionais em comunidade.">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow">Clube de computação com foco em sistemas</div>
        <h1 id="hero-title">
          Entenda como o software <span>realmente funciona.</span>
        </h1>
        <p>
          Nosso foco é estudar C, Rust, arquitetura de computadores e sistemas
          operacionais, compartilhando perguntas, experimentos e projetos.
        </p>
        <div class="actions">
          <JoinLink />
          <a class="button secondary" href="/desafios">
            Conhecer os desafios <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-note">
          <span aria-hidden="true">↳</span> Online, gratuito e aberto a quem
          está começando.
        </div>
      </div>
      <aside
        class="byte-study"
        aria-label="Um olhar sobre os bytes da palavra curiosidade"
      >
        <div class="study-label">
          <span>FIG. 01</span>
          <span>UM OLHAR MAIS DE PERTO</span>
        </div>
        <div class="word">
          <span class="sr-only">curiosidade</span>
          <span aria-hidden="true">
            {[...'curiosidade'].map((letter, index) => (
              <span
                data-letter={index}
                data-active={index === 0 ? '' : undefined}
              >
                {letter}
              </span>
            ))}
          </span>
          <span class="cursor" aria-hidden="true">
            _
          </span>
        </div>
        <div class="byte-bracket" aria-hidden="true"></div>
        <div class="hex-grid" aria-label="Bytes ASCII em hexadecimal">
          {[
            '63',
            '75',
            '72',
            '69',
            '6F',
            '73',
            '69',
            '64',
            '61',
            '64',
            '65',
            '0A',
          ].map((byte, index) => (
            <button
              type="button"
              class:list={['byte', { newline: index === 11 }]}
              data-index={index}
              data-active={index === 0 ? '' : undefined}
              aria-describedby={`byte-binary-${index}`}
              data-hex={byte}
              style={`--byte-delay: ${index * 65}ms`}
              aria-label={`${index === 11 ? 'Fim de linha LF' : `Letra ${'curiosidade'[index]}, posição ${index + 1}`}: hexadecimal ${byte}`}
            >
              <span>{byte}</span>
              <small>{index === 11 ? '\\n' : 'curiosidade'[index]}</small>
              <span class="sr-only" id={`byte-binary-${index}`}>
                Binário: {parseInt(byte, 16).toString(2).padStart(8, '0')}.
              </span>
            </button>
          ))}
        </div>
        <p class="byte-instruction">
          Explore os bytes com o ponteiro, toque ou teclado.
        </p>
        <div class="binary byte-readout" aria-hidden="true">
          c → 0x63 → 01100011
        </div>
        <div class="study-bottom">
          <span>11 caracteres ASCII + quebra de linha (LF) = 12 bytes.</span>
          <span>ASCII / HEX</span>
        </div>
      </aside>
    </section>
    <div class="discipline-strip" aria-label="Áreas de interesse">
      <span>Assuntos que investigamos</span>
      <ul>
        <li>Memória</li>
        <li>Processos</li>
        <li>Arquitetura</li>
        <li>Compiladores</li>
        <li>Sistemas operacionais</li>
      </ul>
    </div>
    <section class="section" id="o-clube" aria-labelledby="club-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">O clube</div>
          <h2 id="club-heading">O que acontece no clube</h2>
        </div>
        <p>
          No Discord, compartilhamos perguntas, leituras e tentativas para
          investigar como os programas e os computadores funcionam.
        </p>
      </div>
      <div class="club-paths">
        <article>
          <h3>Desafios</h3>
          <p>
            Implemente uma ideia, compartilhe uma dúvida ou um caso de teste e
            compare abordagens com outras pessoas.
          </p>
        </article>
        <article>
          <h3>Projetos</h3>
          <p>
            Apresente um projeto em andamento e compartilhe decisões,
            dificuldades e descobertas ao longo do desenvolvimento.
          </p>
        </article>
        <article>
          <h3>Estudos e discussões</h3>
          <p>
            Traga uma referência ou uma pergunta e investigue um assunto com a
            comunidade.
          </p>
        </article>
        <article>
          <h3>Notas e textos técnicos</h3>
          <p>
            Escreva sobre algo que estudou, implementou ou investigou. Quem
            participa do clube pode contribuir com textos para o site, com
            crédito de autoria.
          </p>
          <a class="text-link" href="/notas/#contribuir">
            Como contribuir com um texto <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
      <p class="club-invitation">
        Compartilhe uma tentativa, compare abordagens e volte para contar o que
        descobriu. Uma pergunta sobre o trabalho de outra pessoa também é uma
        forma de participar.
      </p>
      <p class="club-planning">
        <a class="text-link" href="/encontros/">
          {meetings.length
            ? 'Conheça os encontros do clube'
            : 'Conheça os encontros em preparação'}{' '}
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </section>
    {startingChallenge && (
      <section class="section" aria-labelledby="challenge-heading">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Uma ideia para começar</div>
            <h2 id="challenge-heading">
              Construa seu próprio <code>wc</code>
            </h2>
          </div>
          <p>
            Como um programa conta linhas, palavras e bytes? Implemente uma
            versão dessa ferramenta em C e explore leitura de dados e
            gerenciamento de estado.
          </p>
        </div>
        <div class="wc-example" aria-label="Exemplo de contagem do wc">
          <p>
            Entrada representada: <code>ola, mundo\n</code>
          </p>
          <p class="wc-result">1 linha · 2 palavras · 11 bytes</p>
          <p>
            \n representa uma quebra de linha LF. Bytes:{' '}
            <code>6F 6C 61 2C 20 6D 75 6E 64 6F 0A</code>.
          </p>
        </div>
        <div class="actions">
          <a class="text-link" href={`/desafios/${startingChallenge.id}`}>
            Ver o desafio <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="/desafios">
            Ver todos os desafios <span aria-hidden="true">→</span>
          </a>
        </div>
      </section>
    )}
    <section class="section learning" aria-labelledby="learning-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Nosso método</div>
          <h2 id="learning-heading">Explore. Experimente. Explique.</h2>
        </div>
        <p>
          Como um programa pede ao sistema operacional para ler um arquivo?
          Investigue uma syscall, faça um experimento e compartilhe o que
          descobriu.
        </p>
      </div>
    </section>
    <StartHere />
  </div>
</BaseLayout>
<script>
  const study = document.querySelector<HTMLElement>('.byte-study');
  if (study) {
    const bytes = [...study.querySelectorAll<HTMLButtonElement>('.byte')];
    const letters = [...study.querySelectorAll<HTMLElement>('[data-letter]')];
    const readout = study.querySelector<HTMLElement>('.byte-readout')!;
    let demonstrated = bytes[0];
    let hovered: HTMLButtonElement | null = null;
    const update = () => {
      const active =
        hovered ??
        bytes.find((byte) => byte === document.activeElement) ??
        demonstrated;
      bytes.forEach((byte) =>
        byte.toggleAttribute('data-active', byte === active),
      );
      letters.forEach((letter) =>
        letter.toggleAttribute(
          'data-active',
          letter.dataset.letter === active?.dataset.index,
        ),
      );
      const index = Number(active.dataset.index);
      const hex = active.dataset.hex!;
      readout.textContent = `${index === 11 ? 'LF' : 'curiosidade'[index]} → 0x${hex} → ${parseInt(hex, 16).toString(2).padStart(8, '0')}`;
      study.classList.add('inspected');
    };
    bytes.forEach((byte) => {
      byte.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'touch') return;
        hovered = byte;
        update();
      });
      byte.addEventListener('pointerleave', () => {
        hovered = null;
        update();
      });
      byte.addEventListener('focus', () => {
        hovered = null;
        demonstrated = byte;
        update();
      });
      byte.addEventListener('blur', update);
      byte.addEventListener('click', () => {
        byte.focus();
        update();
      });
    });
  }
</script>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 84px 72px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > :is(h1, p, .actions) {
      animation: hero-enter 300ms ease-out backwards;
    }
    .hero-copy > p {
      animation-delay: 45ms;
    }
    .hero-copy > .actions {
      animation-delay: 90ms;
    }
    .hero-copy > .actions:focus-within {
      animation: none;
    }
  }
  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .hero .eyebrow {
    font-size: 10px;
    margin-bottom: 28px;
  }
  .hero h1 {
    font-size: clamp(42px, 5.2vw, 66px);
    letter-spacing: -0.06em;
    line-height: 1.1;
  }
  .hero h1 > span {
    color: var(--color-accent-text);
  }
  .hero-copy > p {
    font-size: 16px;
    max-width: 510px;
    margin: 28px 0 32px;
    line-height: 1.75;
  }
  .hero-note {
    font: 13px/1.7 var(--font-mono);
    color: var(--color-muted);
    margin-top: 22px;
  }
  .hero-note > span {
    color: var(--color-accent-text);
    margin-right: 6px;
  }
  .byte-study {
    align-self: center;
    padding-top: 18px;
    min-width: 0;
  }
  .study-label,
  .study-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 11px/1.6 var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }
  .word {
    font: 34px var(--font-mono);
    letter-spacing: -1.5px;
    padding: 38px 0 24px;
  }
  .cursor {
    color: var(--color-accent);
  }
  .byte-bracket {
    height: 16px;
    border: 1px solid #71503d;
    border-bottom: 0;
    margin-bottom: 16px;
  }
  .hex-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 7px;
  }
  .byte {
    border: 1px solid var(--color-border);
    padding: 10px 2px 8px;
    text-align: center;
    background: #1c1f21;
    font: 16px var(--font-mono);
    color: var(--color-text);
    border-radius: 0;
    cursor: pointer;
    min-width: 0;
    animation: byte-scan 360ms ease-out var(--byte-delay) 1;
    transition:
      border-color 160ms ease,
      background-color 160ms ease,
      color 160ms ease;
  }
  @keyframes byte-scan {
    45% {
      border-color: var(--color-accent);
      background-color: #38271e;
      color: var(--color-accent-text);
    }
  }
  .inspected .byte {
    animation: none;
  }
  .byte[data-active] {
    border-color: var(--color-accent);
    background-color: #38271e;
    color: var(--color-accent-text);
  }
  .word [data-letter] {
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }
  .word [data-active] {
    color: var(--color-accent-text);
    background-color: #38271e;
    box-shadow: 0 2px var(--color-accent);
  }
  .byte small {
    display: block;
    color: var(--color-muted);
    font-size: 11px;
    margin-top: 7px;
  }
  .byte.newline {
    border-color: #71503d;
    color: var(--color-accent-text);
    background: #28221e;
  }
  .byte-instruction {
    margin-top: 18px;
    font: 11px/1.6 var(--font-mono);
    text-align: center;
  }
  .wc-example {
    border-left: 2px solid var(--color-accent);
    padding: 16px 20px;
    margin-bottom: 24px;
    font: 13px/1.8 var(--font-mono);
  }
  .wc-example p {
    font-size: inherit;
  }
  .wc-example .wc-result {
    color: var(--color-text);
    margin-block: 8px;
  }
  .binary {
    font: 12px/1.6 var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0;
    min-height: 2.5em;
    text-align: center;
    margin-block: 10px 24px;
  }
  .study-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
    font-size: 11px;
  }
  .discipline-strip {
    display: flex;
    align-items: center;
    gap: 20px 32px;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-border);
    padding-block: 24px;
    font: 12px/1.6 var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }
  .discipline-strip ul {
    display: flex;
    gap: 12px 20px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    color: var(--color-text);
    font-size: 11px;
  }
  .discipline-strip li::before {
    content: '·';
    color: #777e80;
    margin-right: 15px;
  }
  .club-invitation {
    max-width: 75ch;
    margin-top: 32px;
    font-size: 14px;
  }
  .club-planning {
    max-width: 75ch;
    margin-top: 20px;
    font-size: 14px;
  }
  .club-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .club-paths article {
    min-width: 0;
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }
  .club-paths h3 {
    margin-bottom: 16px;
  }
  .club-paths .text-link {
    margin-top: 16px;
    font-size: 14px;
  }
  .club-paths p {
    font-size: 14px;
  }
  .section-heading > div {
    min-width: 0;
    max-width: 580px;
  }
  .section-heading > p {
    flex-shrink: 0;
  }
  .section > .actions {
    gap: 12px 28px;
  }
  .learning .section-heading {
    margin-bottom: 0;
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 32px;
    }
    .hero h1 {
      font-size: 48px;
    }
    .word {
      font-size: 28px;
    }
    .discipline-strip {
      gap: 20px;
    }
    .discipline-strip ul {
      gap: 12px;
    }
    .binary {
      letter-spacing: 0;
    }
  }
  @media (max-width: 700px) {
    .club-paths {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
    .hero {
      grid-template-columns: 1fr;
      padding-block: 48px;
      gap: 44px;
    }
    .hero h1 {
      font-size: clamp(37px, 8.5vw, 54px);
    }
    .hero .eyebrow {
      font-size: 9px;
      letter-spacing: 0.07em;
    }
    .hero-copy > p {
      font-size: 15px;
    }
    .byte-study {
      max-width: 460px;
      width: 100%;
    }
    .word {
      font-size: 32px;
      padding-top: 24px;
    }
    .hex-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .discipline-strip {
      align-items: start;
      flex-direction: column;
      gap: 16px;
    }
    .discipline-strip ul {
      margin: 0;
      flex-wrap: wrap;
      gap: 12px 20px;
      font-size: 11px;
    }
    .discipline-strip li::before {
      margin-right: 8px;
    }
  }
</style>
