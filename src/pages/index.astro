---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinLink from '../components/JoinLink.astro';
import ChallengeCard from '../components/ChallengeCard.astro';
import { publishedChallenges } from '../lib/challenges';
const featured = (await publishedChallenges()).find(
  (challenge) => challenge.data.featured,
)!;
---

<BaseLayout>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow">Comunidade de programação de sistemas</div>
        <h1 id="hero-title">
          Explore computação
          <br />
          <span>em profundidade.</span>
        </h1>
        <p>
          Uma comunidade independente dedicada à programação de sistemas e aos
          fundamentos da computação. Investigamos problemas, experimentamos
          soluções e compartilhamos conhecimento técnico.
        </p>
        <div class="actions">
          <JoinLink />
          <a class="button secondary" href="/desafios">
            Explorar desafios <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-note">
          <span aria-hidden="true">↳</span> Curiosidade compartilhada.
          Investigação aberta.
        </div>
      </div>
      <aside
        class="byte-study"
        aria-label="Um olhar sobre os bytes da palavra curiosidade"
      >
        <div class="study-label">
          <span>FIG. 01</span>
          <span>UM OLHAR MAIS DE PERTO</span>
        </div>
        <div class="word">
          curiosidade
          <span class="cursor" aria-hidden="true">
            _
          </span>
        </div>
        <div class="byte-bracket" aria-hidden="true"></div>
        <div class="hex-grid" aria-label="Bytes ASCII em hexadecimal">
          {[
            '63',
            '75',
            '72',
            '69',
            '6F',
            '73',
            '69',
            '64',
            '61',
            '64',
            '65',
            '0A',
          ].map((byte, index) => (
            <div class:list={['byte', { newline: index === 11 }]}>
              <span>{byte}</span>
              <small>{index === 11 ? '\\n' : 'curiosidade'[index]}</small>
            </div>
          ))}
        </div>
        <div class="binary" aria-hidden="true">
          01100011 01110101 01110010 01101001
        </div>
        <div class="study-bottom">
          <span>11 letras. 12 bytes com LF.</span>
          <span>ASCII / HEX</span>
        </div>
      </aside>
    </section>
    <div class="discipline-strip" aria-label="Áreas de interesse">
      <span>ENTENDA O QUE EXISTE POR BAIXO</span>
      <ul>
        <li>Memória</li>
        <li>Processos</li>
        <li>Compiladores</li>
        <li>Sistemas</li>
      </ul>
      <span class="strip-plus" aria-hidden="true">
        +
      </span>
    </div>
    <section class="section" aria-labelledby="challenge-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">01 / Desafios práticos</div>
          <h2 id="challenge-heading">Problemas que merecem investigação.</h2>
        </div>
        <a class="text-link" href="/desafios">
          Todos os desafios <span aria-hidden="true">↗</span>
        </a>
      </div>
      <p class="challenge-lead">
        Construa implementações, investigue comportamentos e compare decisões de
        engenharia. Fazer o código funcionar é parte da investigação.
      </p>
      <ChallengeCard challenge={featured} />
      <div class="section-foot">
        <span>Especificação aberta. Sem conta, sem prazo, sem ranking.</span>
        <span class="mono">Leia. Experimente. Questione.</span>
      </div>
    </section>
    <section class="section learning" aria-labelledby="learning-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">02 / Nosso método</div>
          <h2 id="learning-heading">
            Explore. Experimente.
            <br />
            Explique.
          </h2>
        </div>
        <p>
          Da hipótese à evidência: código, medições, depuração e análise ajudam
          a entender o comportamento dos sistemas e as escolhas por trás de cada
          solução.
        </p>
      </div>
      <div class="method">
        <article>
          <span class="step">
            01 <span aria-hidden="true">↗</span>
          </span>
          <h3>Explorar.</h3>
          <p>
            Delimite o problema, investigue conceitos e formule hipóteses.
            Consulte documentação, pesquisas e implementações para encontrar
            perguntas que valem um experimento.
          </p>
        </article>
        <article>
          <span class="step">
            02 <span aria-hidden="true">↗</span>
          </span>
          <h3>Experimentar.</h3>
          <p>
            Implemente, depure, faça profiling e meça resultados. Compare
            algoritmos, uso de memória e desempenho; revise suas hipóteses
            diante das evidências.
          </p>
        </article>
        <article>
          <span class="step">
            03 <span aria-hidden="true">↗</span>
          </span>
          <h3>Explicar.</h3>
          <p>
            Compartilhe código, medições e descobertas com contexto. Discuta
            decisões, limites do experimento e alternativas para que outras
            pessoas possam verificar e ampliar a investigação.
          </p>
        </article>
      </div>
      <div class="live">
        <div class="live-label">
          <span class="live-dot" aria-hidden="true"></span> Oxide Live{' '}
          <span class="tag">No Discord</span>
        </div>
        <div>
          <h3>Investigar ao vivo. Discutir as escolhas.</h3>
          <p>
            No Discord, exploramos um problema com pesquisa e escopo preparados:
            implementamos, testamos, depuramos e discutimos alternativas ao
            vivo. O piloto de três meses usa C e prevê um desafio principal e
            uma sessão de 60–75 minutos por mês. A implementação apresentada é
            uma abordagem possível; perguntas e contrapontos entram pelo chat.
          </p>
          <span class="live-note">
            Datas anunciadas quando confirmadas. Você pode acompanhar sem ter
            tentado o desafio ou continuar a investigação de forma assíncrona.
          </span>
        </div>
      </div>
    </section>
    <section class="section club" id="o-clube" aria-labelledby="club-heading">
      <div>
        <div class="eyebrow">03 / O clube</div>
        <h2 id="club-heading">
          Fundamentos sólidos.
          <br />
          Portas abertas.
        </h2>
      </div>
      <div class="club-copy">
        <p>
          O Oxide Club reúne pessoas interessadas em investigar como
          computadores e software funcionam. Engenharia de software, linguagens,
          sistemas operacionais, compiladores, memória, concorrência e
          arquitetura fazem parte dos nossos interesses.
        </p>
        <p>
          Engenheiros, programadores de sistemas, pesquisadores, estudantes e
          autodidatas encontram espaço para trocar conhecimento, com diferentes
          experiências. Nascemos entre estudantes, sem vínculo institucional; a
          participação é remota, livre e gratuita. C é o ponto de partida do
          piloto, não o limite das nossas investigações.
        </p>
        <div class="principles">
          <span>Curiosidade, não competição.</span>
          <span>Rigor técnico, sem elitismo.</span>
          <span>Participação livre e gratuita.</span>
        </div>
      </div>
    </section>
    <section
      class="section participate"
      id="como-participar"
      aria-labelledby="participate-heading"
    >
      <div>
        <div class="eyebrow">04 / Como participar</div>
        <h2 id="participate-heading">
          Traga uma pergunta.
          <br />
          Amplie a conversa.
        </h2>
        <p>
          Traga projetos, experimentos, ferramentas e ideias. Compare
          abordagens, proponha desafios e compartilhe o que está investigando.
        </p>
        <JoinLink />
      </div>
      <ol class="onboarding">
        <li>
          <span class="mono" aria-hidden="true">
            01
          </span>
          <div>
            <h3>Entre na comunidade.</h3>
            <p>
              Acesse o Discord, aceite as regras e selecione seus interesses.
              Eles indicam curiosidade, não nível de experiência.
            </p>
          </div>
        </li>
        <li>
          <span class="mono" aria-hidden="true">
            02
          </span>
          <div>
            <h3>Passe no #comece-aqui.</h3>
            <p>
              Encontre o desafio atual e os avisos de encontros. Apresentar-se é
              bem-vindo, mas não é obrigatório.
            </p>
          </div>
        </li>
        <li>
          <span class="mono" aria-hidden="true">
            03
          </span>
          <div>
            <h3>Participe do seu jeito.</h3>
            <p>
              Discuta código, compartilhe um benchmark, proponha uma
              investigação ou acompanhe a conversa. Perguntas e experimentos em
              andamento também são contribuições.
            </p>
          </div>
        </li>
      </ol>
    </section>
    <div class="closing">
      <p>
        A próxima descoberta pode começar
        <br />
        com uma pergunta sua.
      </p>
      <a class="text-link" href="/desafios">
        Encontre um desafio <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</BaseLayout>
<style>
  .challenge-lead {
    max-width: 70ch;
    margin-bottom: 28px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 84px 72px;
  }
  .hero .eyebrow {
    font-size: 10px;
    margin-bottom: 28px;
  }
  .hero h1 {
    font-size: clamp(42px, 5.2vw, 66px);
    letter-spacing: -0.06em;
    line-height: 1.1;
  }
  .hero h1 > span {
    color: var(--color-accent-text);
  }
  .hero-copy > p {
    font-size: 16px;
    max-width: 510px;
    margin: 28px 0 32px;
    line-height: 1.75;
  }
  .hero-note {
    font: 10px/1.7 var(--font-mono);
    color: var(--color-muted);
    margin-top: 22px;
  }
  .hero-note > span {
    color: var(--color-accent-text);
    margin-right: 6px;
  }
  .byte-study {
    align-self: center;
    padding-top: 18px;
    min-width: 0;
  }
  .study-label,
  .study-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 8px var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }
  .word {
    font: 34px var(--font-mono);
    letter-spacing: -1.5px;
    padding: 38px 0 24px;
  }
  .cursor {
    color: var(--color-accent);
  }
  .byte-bracket {
    height: 16px;
    border: 1px solid #71503d;
    border-bottom: 0;
    margin-bottom: 16px;
  }
  .hex-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 7px;
  }
  .byte {
    border: 1px solid var(--color-border);
    padding: 10px 2px 8px;
    text-align: center;
    background: #1c1f21;
    font: 16px var(--font-mono);
  }
  .byte small {
    display: block;
    color: var(--color-muted);
    font-size: 9px;
    margin-top: 7px;
  }
  .byte.newline {
    border-color: #71503d;
    color: var(--color-accent-text);
    background: #28221e;
  }
  .binary {
    font: 9px var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 2px;
    text-align: center;
    margin-block: 18px 28px;
  }
  .study-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
    font-size: 8px;
  }
  .discipline-strip {
    display: flex;
    align-items: center;
    gap: 32px;
    border-top: 1px solid var(--color-border);
    padding-block: 24px;
    font: 9px var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }
  .discipline-strip ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    color: var(--color-text);
    font-size: 11px;
  }
  .discipline-strip li::before {
    content: '/';
    color: #777e80;
    margin-right: 15px;
  }
  .strip-plus {
    font-size: 18px;
  }
  .section-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
    font-size: 10px;
    color: var(--color-muted);
  }
  .section-foot .mono {
    font-size: 9px;
  }
  .method {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 48px;
  }
  .method article {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }
  .step {
    display: flex;
    justify-content: space-between;
    color: var(--color-accent-text);
    font: 11px var(--font-mono);
    margin-bottom: 32px;
  }
  .step > span {
    color: var(--color-muted);
  }
  .method h3 {
    margin-bottom: 16px;
  }
  .method p {
    font-size: 14px;
  }
  .live {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 36px;
    padding: 32px;
    background: var(--color-surface);
    border-radius: 8px;
    margin-top: 48px;
  }
  .live-label {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    align-content: start;
    font-weight: 600;
    font-size: 18px;
    letter-spacing: -0.03em;
  }
  .live-label .tag {
    margin-left: 18px;
    font-weight: 400;
  }
  .live-dot {
    height: 7px;
    width: 7px;
    border: 1px solid var(--color-accent-text);
    border-radius: 50%;
  }
  .live h3 {
    font-size: 23px;
    margin-bottom: 12px;
  }
  .live p {
    font-size: 13px;
  }
  .live-note {
    display: block;
    margin-top: 16px;
    font-size: 10px;
    color: var(--color-muted);
  }
  .club,
  .participate {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .club .eyebrow,
  .participate .eyebrow {
    margin-bottom: 24px;
  }
  .club h2,
  .participate h2 {
    font-size: 42px;
  }
  .club-copy p {
    font-size: 14px;
    margin-bottom: 24px;
  }
  .club-copy p:first-child {
    color: var(--color-text);
  }
  .principles {
    display: flex;
    flex-direction: column;
    font-size: 12px;
    gap: 12px;
    margin-top: 32px;
  }
  .principles span::before {
    content: '+';
    font-family: var(--font-mono);
    color: var(--color-accent-text);
    margin-right: 16px;
  }
  .participate > div > p {
    font-size: 14px;
    margin: 24px 0 28px;
  }
  .onboarding {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .onboarding li {
    display: flex;
    gap: 24px;
    padding-block: 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .onboarding li:first-child {
    padding-top: 0;
  }
  .onboarding li:last-child {
    border: 0;
  }
  .onboarding li > .mono {
    font-size: 10px;
    color: var(--color-accent-text);
    padding-top: 4px;
  }
  .onboarding h3 {
    font-size: 20px;
    margin-bottom: 12px;
  }
  .onboarding p {
    font-size: 13px;
  }
  .closing {
    padding-block: 40px 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .closing p {
    font-size: 24px;
    line-height: 1.35;
    color: var(--color-text);
    letter-spacing: -0.035em;
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 32px;
    }
    .hero h1 {
      font-size: 48px;
    }
    .word {
      font-size: 28px;
    }
    .study-label {
      font-size: 7px;
    }
    .discipline-strip {
      gap: 20px;
    }
    .discipline-strip ul {
      gap: 12px;
    }
    .club,
    .participate {
      gap: 40px;
    }
    .live {
      grid-template-columns: 1fr 1.6fr;
    }
    .binary {
      letter-spacing: 0;
    }
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 48px;
      gap: 44px;
    }
    .hero h1 {
      font-size: clamp(37px, 8.5vw, 54px);
    }
    .hero .eyebrow {
      font-size: 9px;
      letter-spacing: 0.07em;
    }
    .hero-copy > p {
      font-size: 15px;
    }
    .hero-note {
      font-size: 10px;
    }
    .byte-study {
      max-width: 460px;
      width: 100%;
    }
    .study-label,
    .study-bottom {
      font-size: 9px;
    }
    .word {
      font-size: 32px;
      padding-top: 24px;
    }
    .hex-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .binary {
      font-size: 10px;
    }
    .discipline-strip {
      align-items: start;
      flex-direction: column;
      gap: 16px;
    }
    .discipline-strip ul {
      margin: 0;
      flex-wrap: wrap;
      gap: 12px 20px;
      font-size: 10px;
    }
    .discipline-strip li::before {
      margin-right: 8px;
    }
    .strip-plus {
      display: none;
    }
    .section-foot {
      flex-direction: column;
      gap: 8px;
      font-size: 11px;
    }
    .section-foot .mono {
      font-size: 10px;
    }
    .method {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 32px;
    }
    .step {
      margin-bottom: 20px;
    }
    .live {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px;
    }
    .live-label .tag {
      margin-left: 0;
    }
    .live-note {
      font-size: 11px;
    }
    .club,
    .participate {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .club h2,
    .participate h2 {
      font-size: 36px;
    }
    .closing {
      align-items: start;
      flex-direction: column;
      padding-top: 0;
    }
    .closing p {
      font-size: 22px;
    }
  }
</style>
