---
import BaseLayout from '../layouts/BaseLayout.astro';
import JoinLink from '../components/JoinLink.astro';
import FeaturedContent from '../components/FeaturedContent.astro';
---

<BaseLayout>
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <div class="eyebrow">Comunidade de programação de sistemas</div>
        <h1 id="hero-title">
          Entenda como o software <span>realmente funciona.</span>
        </h1>
        <p>
          Uma comunidade independente para aprender construindo programas,
          investigando comportamentos e explorando os fundamentos da computação.
        </p>
        <div class="actions">
          <JoinLink />
          <a class="button secondary" href="#o-clube">
            Explorar conteúdos <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="hero-note">
          <span aria-hidden="true">↳</span> Participação remota, livre e
          gratuita. Iniciantes são bem-vindos.
        </div>
      </div>
      <aside
        class="byte-study"
        aria-label="Um olhar sobre os bytes da palavra curiosidade"
      >
        <div class="study-label">
          <span>FIG. 01</span>
          <span>UM OLHAR MAIS DE PERTO</span>
        </div>
        <div class="word">
          curiosidade
          <span class="cursor" aria-hidden="true">
            _
          </span>
        </div>
        <div class="byte-bracket" aria-hidden="true"></div>
        <div class="hex-grid" aria-label="Bytes ASCII em hexadecimal">
          {[
            '63',
            '75',
            '72',
            '69',
            '6F',
            '73',
            '69',
            '64',
            '61',
            '64',
            '65',
            '0A',
          ].map((byte, index) => (
            <div class:list={['byte', { newline: index === 11 }]}>
              <span>{byte}</span>
              <small>{index === 11 ? '\\n' : 'curiosidade'[index]}</small>
            </div>
          ))}
        </div>
        <div class="binary" aria-hidden="true">
          01100011 01110101 01110010 01101001
        </div>
        <div class="study-bottom">
          <span>11 letras. 12 bytes com LF.</span>
          <span>ASCII / HEX</span>
        </div>
      </aside>
    </section>
    <div class="discipline-strip" aria-label="Áreas de interesse">
      <span>ENTENDA O QUE EXISTE POR BAIXO</span>
      <ul>
        <li>Memória</li>
        <li>Processos</li>
        <li>Compiladores</li>
        <li>Sistemas</li>
      </ul>
      <span class="strip-plus" aria-hidden="true">
        +
      </span>
    </div>
    <section class="section" id="o-clube" aria-labelledby="activities-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">01 / O clube</div>
          <h2 id="activities-heading">O que fazemos</h2>
        </div>
        <p>
          Estudamos programação de sistemas juntos, com espaço para quem está
          começando e para quem já tem experiência.
        </p>
      </div>
      <div class="method activities">
        <article>
          <h3>Desafios</h3>
          <p>
            Problemas práticos para estudar conceitos e implementar soluções.
            Escreva código, teste casos e compare suas decisões com as de outras
            pessoas.
          </p>
          <a class="text-link" href="/desafios">
            Conhecer os desafios <span aria-hidden="true">↗</span>
          </a>
        </article>
        <article>
          <h3>Oxide Live</h3>
          <p>
            Encontros de programação ao vivo para depurar, testar e discutir
            decisões técnicas. Você pode acompanhar, fazer perguntas e trazer
            suas próprias investigações.
          </p>
          <p class="activity-note">
            Datas anunciadas no Discord quando confirmadas.
          </p>
        </article>
        <article>
          <h3>Notas técnicas</h3>
          <p>
            Textos e experimentos para documentar conceitos, resultados e
            aprendizados de forma que outras pessoas possam reproduzi-los.
          </p>
          <a class="text-link" href="/notas">
            Abrir o caderno <span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>
    </section>
    <FeaturedContent />
    <section class="section learning" aria-labelledby="learning-heading">
      <div class="section-heading">
        <div>
          <div class="eyebrow">03 / Nosso método</div>
          <h2 id="learning-heading">
            Explore. Experimente.
            <br />
            Explique.
          </h2>
        </div>
        <p>
          Uma pergunta orienta o estudo. Um teste ajuda a verificar a ideia. Uma
          explicação torna o resultado útil para outras pessoas.
        </p>
      </div>
      <div class="method">
        <article>
          <span class="step">
            01 <span aria-hidden="true">↗</span>
          </span>
          <h3>Explorar.</h3>
          <p>
            Escolha uma pergunta e consulte a documentação. Anote o que você
            espera observar e o que ainda precisa entender.
          </p>
        </article>
        <article>
          <span class="step">
            02 <span aria-hidden="true">↗</span>
          </span>
          <h3>Experimentar.</h3>
          <p>
            Escreva um programa pequeno, varie as entradas e meça os resultados.
            Use testes e depuração para conferir suas hipóteses.
          </p>
        </article>
        <article>
          <span class="step">
            03 <span aria-hidden="true">↗</span>
          </span>
          <h3>Explicar.</h3>
          <p>
            Mostre o código, as condições do teste e o que aprendeu. Registre
            também os limites do resultado e as perguntas que ficaram abertas.
          </p>
        </article>
      </div>
    </section>
    <section
      class="section participate"
      id="como-participar"
      aria-labelledby="participate-heading"
    >
      <div>
        <div class="eyebrow">04 / Como participar</div>
        <h2 id="participate-heading">Comece de onde você está.</h2>
        <p>
          Não é preciso ter um projeto pronto ou uma resposta definitiva para
          participar. Dúvidas, experimentos em andamento e anotações de estudo
          também fazem parte da troca.
        </p>
        <JoinLink />
      </div>
      <ol class="onboarding">
        <li>
          <span class="mono" aria-hidden="true">
            01
          </span>
          <div>
            <h3>Explore os conteúdos.</h3>
            <p>
              Explore os desafios e as notas técnicas. Escolha um assunto que
              desperte sua curiosidade ou traga uma pergunta sua.
            </p>
          </div>
        </li>
        <li>
          <span class="mono" aria-hidden="true">
            02
          </span>
          <div>
            <h3>Faça um experimento.</h3>
            <p>
              Teste uma ideia, reproduza um resultado ou investigue uma dúvida.
              Comece com um exemplo pequeno e registre o que observar.
            </p>
          </div>
        </li>
        <li>
          <span class="mono" aria-hidden="true">
            03
          </span>
          <div>
            <h3>Compartilhe com a comunidade.</h3>
            <p>
              Compartilhe perguntas, código e anotações. Use as discussões e os
              espaços de contribuição indicados em cada conteúdo, mesmo que sua
              investigação ainda esteja em andamento.
            </p>
          </div>
        </li>
      </ol>
    </section>
    <div class="closing">
      <p>
        A próxima descoberta pode começar
        <br />
        com uma pergunta sua.
      </p>
      <a class="text-link" href="#o-clube">
        Explore os conteúdos <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</BaseLayout>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 48px;
    align-items: center;
    padding-block: 84px 72px;
  }
  .hero .eyebrow {
    font-size: 10px;
    margin-bottom: 28px;
  }
  .hero h1 {
    font-size: clamp(42px, 5.2vw, 66px);
    letter-spacing: -0.06em;
    line-height: 1.1;
  }
  .hero h1 > span {
    color: var(--color-accent-text);
  }
  .hero-copy > p {
    font-size: 16px;
    max-width: 510px;
    margin: 28px 0 32px;
    line-height: 1.75;
  }
  .hero-note {
    font: 10px/1.7 var(--font-mono);
    color: var(--color-muted);
    margin-top: 22px;
  }
  .hero-note > span {
    color: var(--color-accent-text);
    margin-right: 6px;
  }
  .byte-study {
    align-self: center;
    padding-top: 18px;
    min-width: 0;
  }
  .study-label,
  .study-bottom {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font: 8px var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 0.05em;
  }
  .word {
    font: 34px var(--font-mono);
    letter-spacing: -1.5px;
    padding: 38px 0 24px;
  }
  .cursor {
    color: var(--color-accent);
  }
  .byte-bracket {
    height: 16px;
    border: 1px solid #71503d;
    border-bottom: 0;
    margin-bottom: 16px;
  }
  .hex-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 7px;
  }
  .byte {
    border: 1px solid var(--color-border);
    padding: 10px 2px 8px;
    text-align: center;
    background: #1c1f21;
    font: 16px var(--font-mono);
  }
  .byte small {
    display: block;
    color: var(--color-muted);
    font-size: 9px;
    margin-top: 7px;
  }
  .byte.newline {
    border-color: #71503d;
    color: var(--color-accent-text);
    background: #28221e;
  }
  .binary {
    font: 9px var(--font-mono);
    color: var(--color-muted);
    letter-spacing: 2px;
    text-align: center;
    margin-block: 18px 28px;
  }
  .study-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 12px;
    font-size: 8px;
  }
  .discipline-strip {
    display: flex;
    align-items: center;
    gap: 32px;
    border-top: 1px solid var(--color-border);
    padding-block: 24px;
    font: 9px var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--color-muted);
  }
  .discipline-strip ul {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    color: var(--color-text);
    font-size: 11px;
  }
  .discipline-strip li::before {
    content: '/';
    color: #777e80;
    margin-right: 15px;
  }
  .strip-plus {
    font-size: 18px;
  }
  .method {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    margin-top: 48px;
  }
  .method article {
    border-top: 1px solid var(--color-border);
    padding-top: 20px;
  }
  .step {
    display: flex;
    justify-content: space-between;
    color: var(--color-accent-text);
    font: 11px var(--font-mono);
    margin-bottom: 32px;
  }
  .step > span {
    color: var(--color-muted);
  }
  .method h3 {
    margin-bottom: 16px;
  }
  .method p {
    font-size: 14px;
  }
  .activities .activity-note {
    margin-top: 16px;
    font-size: 12px;
  }
  .activities .text-link {
    margin-top: 12px;
  }
  .participate {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
  }
  .participate .eyebrow {
    margin-bottom: 24px;
  }
  .participate h2 {
    font-size: 42px;
  }
  .participate > div > p {
    font-size: 14px;
    margin: 24px 0 28px;
  }
  .onboarding {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .onboarding li {
    display: flex;
    gap: 24px;
    padding-block: 24px;
    border-bottom: 1px solid var(--color-border);
  }
  .onboarding li:first-child {
    padding-top: 0;
  }
  .onboarding li:last-child {
    border: 0;
  }
  .onboarding li > .mono {
    flex-shrink: 0;
    font-size: 10px;
    color: var(--color-accent-text);
    padding-top: 4px;
  }
  .onboarding h3 {
    font-size: 20px;
    margin-bottom: 12px;
  }
  .onboarding p {
    font-size: 13px;
  }
  .closing {
    padding-block: 40px 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .closing p {
    font-size: 24px;
    line-height: 1.35;
    color: var(--color-text);
    letter-spacing: -0.035em;
  }
  @media (max-width: 1000px) {
    .hero {
      gap: 32px;
    }
    .hero h1 {
      font-size: 48px;
    }
    .word {
      font-size: 28px;
    }
    .study-label {
      font-size: 7px;
    }
    .discipline-strip {
      gap: 20px;
    }
    .discipline-strip ul {
      gap: 12px;
    }
    .participate {
      gap: 40px;
    }
    .binary {
      letter-spacing: 0;
    }
  }
  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 48px;
      gap: 44px;
    }
    .hero h1 {
      font-size: clamp(37px, 8.5vw, 54px);
    }
    .hero .eyebrow {
      font-size: 9px;
      letter-spacing: 0.07em;
    }
    .hero-copy > p {
      font-size: 15px;
    }
    .hero-note {
      font-size: 10px;
    }
    .byte-study {
      max-width: 460px;
      width: 100%;
    }
    .study-label,
    .study-bottom {
      font-size: 9px;
    }
    .word {
      font-size: 32px;
      padding-top: 24px;
    }
    .hex-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .binary {
      font-size: 10px;
    }
    .discipline-strip {
      align-items: start;
      flex-direction: column;
      gap: 16px;
    }
    .discipline-strip ul {
      margin: 0;
      flex-wrap: wrap;
      gap: 12px 20px;
      font-size: 10px;
    }
    .discipline-strip li::before {
      margin-right: 8px;
    }
    .strip-plus {
      display: none;
    }
    .method {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-top: 32px;
    }
    .step {
      margin-bottom: 20px;
    }
    .participate {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .participate h2 {
      font-size: 36px;
    }
    .closing {
      align-items: start;
      flex-direction: column;
      padding-top: 0;
    }
    .closing p {
      font-size: 22px;
    }
  }
</style>
