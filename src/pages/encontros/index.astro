---
import TextLink from '../../components/ui/TextLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinLink from '../../components/JoinLink.astro';
import { publishedMeetings } from '../../lib/meetings';
import { meetingWhen, formatLabels } from '../../lib/meeting-source.mjs';
const meetings = await publishedMeetings();
---

<BaseLayout
  title="Encontros"
  description="Agenda e registros das investigações compartilhadas do Oxide Club: pautas, referências, código e materiais das sessões."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Oxide Club / Encontros</div>
      <h1>
        Encontros
        <span class="accent" aria-hidden="true">
          _
        </span>
      </h1>
      <p>Investigação compartilhada, da conversa ao registro técnico.</p>
    </header>
    <section class="agenda" aria-labelledby="meetings-heading">
      <h2 id="meetings-heading" class="sr-only">
        Encontros publicados
      </h2>
      {meetings.length ? (
        <ol class="meetings-list">
          {meetings.map(({ id, data }) => {
            const when = meetingWhen(data);
            return (
              <li>
                <article class="meeting-entry">
                  <div class="meeting-date mono">
                    <time datetime={data.startsAt}>{when.date}</time>
                    <span>{when.time}</span>
                    <span>{when.zone}</span>
                  </div>
                  <div class="meeting-summary">
                    <h3>
                      <a href={`/encontros/${id}/`}>{data.title}</a>
                    </h3>
                    <p>{data.summary}</p>
                    <p class="meeting-place">
                      {formatLabels[data.format]}
                      {data.platform && ` · ${data.platform}`}
                      {data.location && ` · ${data.location}`}
                    </p>
                    {data.cancelled && (
                      <p class="editorial-notice">
                        Cancelado
                        {data.changeNotice && ` · ${data.changeNotice}`}
                      </p>
                    )}
                    {!data.cancelled && data.changeNotice && (
                      <p class="editorial-notice">{data.changeNotice}</p>
                    )}
                    <TextLink href={`/encontros/${id}/`}>
                      Ver encontro <span aria-hidden="true">→</span>
                      <span class="sr-only">: {data.title}</span>
                    </TextLink>
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      ) : (
        <div class="empty-meetings">
          <h3>Primeiros encontros em preparação</h3>
          <p>
            Estamos definindo os primeiros encontros do Oxide Club. Você pode
            sugerir uma leitura, uma dúvida, um desafio ou um projeto para
            explorarmos em conjunto.
          </p>
          <p>
            As datas e o formato de cada atividade serão publicados nesta página
            quando estiverem definidos.
          </p>
          <p>
            O convite leva ao servidor do clube, pelo canal{' '}
            <strong>#comece-aqui</strong>.
          </p>
          <div class="actions">
            <JoinLink label="Entrar no Discord para sugerir um assunto" />
          </div>
        </div>
      )}
    </section>
    <details class="calendar-subscription">
      <summary>Assinar calendário</summary>
      <p>
        Para receber atualizações, adicione este endereço como assinatura no seu
        aplicativo de calendário.
      </p>
      <a class="text-link calendar-address" href="/encontros/calendario.ics">
        https://oxideclub.dev/encontros/calendario.ics
      </a>
      <p>
        Importar o arquivo uma única vez não cria uma assinatura. A frequência
        de atualização depende do aplicativo.
      </p>
    </details>
  </div>
</BaseLayout>
<style>
  .calendar-subscription {
    margin-block: 0 var(--space-16);
    max-width: 66ch;
  }
  .calendar-subscription summary {
    display: list-item;
    width: fit-content;
    min-height: var(--control-height);
    padding-block: 10px;
    cursor: pointer;
    font-size: var(--text-control);
    text-decoration: underline;
    text-underline-offset: 5px;
    transition: color var(--motion-fast) var(--motion-easing);
  }
  .calendar-subscription summary:is(:hover, :focus-visible) {
    color: var(--color-accent-text);
  }
  .calendar-subscription p {
    font-size: var(--text-control);
    margin-block: var(--space-2);
  }
  .calendar-address {
    color: var(--color-accent-text);
    overflow-wrap: anywhere;
  }
  .empty-meetings .actions {
    margin-top: var(--space-6);
  }
  .agenda {
    border-top: 1px solid var(--color-border);
    padding-bottom: var(--space-8);
  }
  .meetings-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 960px;
  }
  .meetings-list > li + li {
    border-top: 1px solid var(--color-border);
  }
  .meeting-entry {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: var(--space-10);
    padding-block: var(--space-8);
    transition:
      background-color var(--motion-fast) var(--motion-easing),
      box-shadow var(--motion-fast) var(--motion-easing);
  }
  .meeting-entry:is(:hover, :focus-within) {
    background-color: var(--color-surface);
    box-shadow:
      -12px 0 var(--color-surface),
      12px 0 var(--color-surface);
  }
  .meeting-date {
    font-size: var(--text-sm);
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-top: var(--space-1);
    transition: color var(--motion-fast) var(--motion-easing);
  }
  .meeting-entry:is(:hover, :focus-within) .meeting-date {
    color: var(--color-accent-text);
  }
  .meeting-date time {
    text-transform: uppercase;
  }
  .meeting-summary h3 {
    margin-bottom: var(--space-3);
  }
  .meeting-summary h3 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    transition:
      color var(--motion-fast) var(--motion-easing),
      text-decoration-color var(--motion-fast) var(--motion-easing);
  }
  .meeting-summary h3 a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
  .meeting-place {
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  .meeting-summary .text-link {
    margin-top: var(--space-2);
  }
  .editorial-notice {
    font-size: var(--text-control);
    margin-top: var(--space-3);
    color: var(--color-accent-text);
  }
  .empty-meetings {
    padding-block: var(--space-8);
    max-width: 68ch;
  }
  .empty-meetings p + p {
    margin-top: var(--space-4);
  }
  .empty-meetings h3 {
    margin-bottom: var(--space-4);
  }
  @media (prefers-reduced-motion: no-preference) {
    .page-intro > :is(h1, p, .calendar-subscription),
    .meetings-list > li,
    .empty-meetings {
      animation: meeting-enter 300ms ease-out backwards;
    }
    .page-intro > p,
    .meetings-list > li:nth-child(2) {
      animation-delay: 45ms;
    }
    .calendar-subscription,
    .meetings-list > li:nth-child(n + 3) {
      animation-delay: 90ms;
    }
    .calendar-subscription[open] > :not(summary) {
      animation: meeting-enter 180ms ease-out;
    }
    .calendar-subscription:focus-within,
    .meetings-list > li:focus-within {
      animation: none;
    }
  }
  @keyframes meeting-enter {
    from {
      transform: translateY(6px);
    }
    to {
      transform: translateY(0);
    }
  }
  @media (max-width: 700px) {
    .meeting-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding-block: var(--space-7);
    }
    .meeting-date {
      gap: 2px;
    }
    .meeting-date span {
      display: block;
    }
  }
  @media (forced-colors: active) {
    .meeting-summary h3 a {
      text-decoration-color: LinkText;
    }
  }
</style>
