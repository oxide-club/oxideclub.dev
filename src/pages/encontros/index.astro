---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedMeetings } from '../../lib/meetings';
import { meetingWhen, formatLabels } from '../../lib/meeting-source.mjs';
const meetings = await publishedMeetings();
---

<BaseLayout
  title="Encontros"
  description="Agenda e registros das investigações compartilhadas do Oxide Club: pautas, referências, código e materiais das sessões."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Oxide Club / Encontros</div>
      <h1>
        Encontros
        <span class="accent" aria-hidden="true">
          _
        </span>
      </h1>
      <p>Investigação compartilhada, da conversa ao registro técnico.</p>
      <details class="calendar-subscription">
        <summary>Assinar calendário</summary>
        <p>
          Para receber atualizações, adicione este endereço como assinatura no
          seu aplicativo de calendário.
        </p>
        <a class="text-link calendar-address" href="/encontros/calendario.ics">
          https://oxideclub.dev/encontros/calendario.ics
        </a>
        <p>
          Importar o arquivo uma única vez não cria uma assinatura. A frequência
          de atualização depende do aplicativo.
        </p>
      </details>
    </header>
    <section class="agenda" aria-labelledby="meetings-heading">
      <h2 id="meetings-heading" class="sr-only">
        Encontros publicados
      </h2>
      {meetings.length ? (
        <ol class="meetings-list">
          {meetings.map(({ id, data }) => {
            const when = meetingWhen(data);
            return (
              <li>
                <article class="meeting-entry">
                  <div class="meeting-date mono">
                    <time datetime={data.startsAt}>{when.date}</time>
                    <span>{when.time}</span>
                    <span>{when.zone}</span>
                  </div>
                  <div class="meeting-summary">
                    <h3>
                      <a href={`/encontros/${id}/`}>{data.title}</a>
                    </h3>
                    <p>{data.summary}</p>
                    <p class="meeting-place">
                      {formatLabels[data.format]}
                      {data.platform && ` · ${data.platform}`}
                      {data.location && ` · ${data.location}`}
                    </p>
                    {data.cancelled && (
                      <p class="editorial-notice">
                        Cancelado
                        {data.changeNotice && ` · ${data.changeNotice}`}
                      </p>
                    )}
                    {!data.cancelled && data.changeNotice && (
                      <p class="editorial-notice">{data.changeNotice}</p>
                    )}
                    <a class="text-link" href={`/encontros/${id}/`}>
                      Ver encontro <span aria-hidden="true">→</span>
                      <span class="sr-only">: {data.title}</span>
                    </a>
                  </div>
                </article>
              </li>
            );
          })}
        </ol>
      ) : (
        <div class="empty-meetings">
          <h3>Ainda não há encontros publicados.</h3>
          <p>
            Este espaço reunirá a agenda, as pautas e os registros técnicos dos
            encontros do clube.
          </p>
        </div>
      )}
    </section>
  </div>
</BaseLayout>
<style>
  .calendar-subscription {
    margin-top: 24px;
    max-width: 66ch;
  }
  .calendar-subscription summary {
    display: list-item;
    width: fit-content;
    min-height: 44px;
    padding-block: 10px;
    cursor: pointer;
    font-size: 14px;
    text-decoration: underline;
    text-underline-offset: 5px;
    transition: color 160ms ease;
  }
  .calendar-subscription summary:is(:hover, :focus-visible) {
    color: var(--color-accent-text);
  }
  .calendar-subscription p {
    font-size: 14px;
    margin-block: 8px;
  }
  .calendar-address {
    color: var(--color-accent-text);
    overflow-wrap: anywhere;
  }
  .agenda {
    border-top: 1px solid var(--color-border);
    padding-bottom: 80px;
  }
  .meetings-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 960px;
  }
  .meetings-list > li + li {
    border-top: 1px solid var(--color-border);
  }
  .meeting-entry {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 40px;
    padding-block: 32px;
    transition:
      background-color 160ms ease,
      box-shadow 160ms ease;
  }
  .meeting-entry:is(:hover, :focus-within) {
    background-color: var(--color-surface);
    box-shadow:
      -12px 0 var(--color-surface),
      12px 0 var(--color-surface);
  }
  .meeting-date {
    font-size: 12px;
    color: var(--color-muted);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 4px;
    transition: color 160ms ease;
  }
  .meeting-entry:is(:hover, :focus-within) .meeting-date {
    color: var(--color-accent-text);
  }
  .meeting-date time {
    text-transform: uppercase;
  }
  .meeting-summary h3 {
    margin-bottom: 12px;
  }
  .meeting-summary h3 a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 1px;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }
  .meeting-summary h3 a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
  .meeting-place {
    font-size: 13px;
    margin-top: 12px;
  }
  .meeting-summary .text-link {
    margin-top: 8px;
  }
  .editorial-notice {
    font-size: 14px;
    margin-top: 12px;
    color: var(--color-accent-text);
  }
  .empty-meetings {
    padding-block: 32px;
    max-width: 68ch;
  }
  .empty-meetings h3 {
    margin-bottom: 16px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .page-intro > :is(h1, p, .calendar-subscription),
    .meetings-list > li,
    .empty-meetings {
      animation: meeting-enter 300ms ease-out backwards;
    }
    .page-intro > p,
    .meetings-list > li:nth-child(2) {
      animation-delay: 45ms;
    }
    .calendar-subscription,
    .meetings-list > li:nth-child(n + 3) {
      animation-delay: 90ms;
    }
    .calendar-subscription[open] > :not(summary) {
      animation: meeting-enter 180ms ease-out;
    }
    .calendar-subscription:focus-within,
    .meetings-list > li:focus-within {
      animation: none;
    }
  }
  @keyframes meeting-enter {
    from {
      transform: translateY(6px);
    }
    to {
      transform: translateY(0);
    }
  }
  @media (max-width: 700px) {
    .meeting-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-block: 28px;
    }
    .meeting-date {
      gap: 2px;
    }
    .meeting-date span {
      display: block;
    }
  }
  @media (forced-colors: active) {
    .meeting-summary h3 a {
      text-decoration-color: LinkText;
    }
  }
</style>
