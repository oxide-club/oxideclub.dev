---
import ButtonLink from '../components/ui/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" noindex>
  <section class="container page-intro missing">
    <div class="eyebrow">404 / Caminho não encontrado</div>
    <h1>
      Uma pista que
      <br />
      não leva a lugar nenhum.
    </h1>
    <p>
      Esta página não existe ou mudou de endereço. Ainda há bastante coisa para
      investigar por aqui.
    </p>
    <div class="actions">
      <ButtonLink href="/">Voltar ao início →</ButtonLink>
      <ButtonLink variant="secondary" href="/desafios">
        Explorar desafios
      </ButtonLink>
    </div>
  </section>
</BaseLayout>
<style>
  .missing {
    padding-block: 96px 120px;
  }
  .actions {
    margin-top: var(--space-8);
  }
</style>
