---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChallengeCard from '../../components/ChallengeCard.astro';
import JoinLink from '../../components/JoinLink.astro';
import { githubUrl } from '../../config/github.mjs';
import { publishedChallenges } from '../../lib/challenges';
import {
  ascendingChallenges,
  challengeSearchText,
} from '../../lib/challenge-catalogue.mjs';
const challenges = ascendingChallenges(await publishedChallenges());
const startingChallenge = challenges.find(({ id }) => id === '001-wc');
const contributeUrl = `${githubUrl('solutions', 'CONTRIBUTING.md', 'blob')}#compartilhar-uma-implementação`;
const runnerGuideUrl = githubUrl('challenges', 'docs/runner.md', 'blob');
const proposalGuideUrl = githubUrl('challenges', 'CONTRIBUTING.md', 'blob');
const topics = [...new Set(challenges.flatMap(({ data }) => data.topics))].sort(
  (a, b) => a.localeCompare(b, 'pt-BR'),
);
---

<BaseLayout
  title="Desafios"
  description="Desafios públicos de computação e programação de sistemas: implemente, depure, meça desempenho e discuta hipóteses e decisões de engenharia."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Desafios</div>
      <h1>Explore sistemas na prática.</h1>
      <p>
        Construa programas para investigar entrada e saída, imagens e compressão
        de dados. Os desafios são construídos com a comunidade: qualquer pessoa
        pode propor um novo desafio por pull request.
      </p>
      <a class="text-link proposal-link" href="#propor-desafio">
        Quer propor um desafio? <span aria-hidden="true">↓</span>
      </a>
    </header>
    <div class="catalogue-guidance">
      {startingChallenge && (
        <p>
          <strong>Primeiro desafio?</strong> O{' '}
          <a href={`/desafios/${startingChallenge.data.slug}`}>wc</a> é uma
          sugestão de início para explorar leitura de dados, contagem e estado.
          Você também pode escolher outro assunto que desperte sua curiosidade.
        </p>
      )}
      <p>
        A dificuldade indica os conhecimentos envolvidos. Você pode explorar
        qualquer desafio e compartilhar suas tentativas. As extensões são
        opcionais.
      </p>
    </div>
    <form
      class="catalogue-filters"
      role="search"
      aria-label="Buscar desafios"
      hidden
    >
      <div class="filter-field">
        <label for="challenge-query">Buscar desafios</label>
        <input
          id="challenge-query"
          type="search"
          placeholder="Título, assunto, linguagem ou nível"
          autocomplete="off"
        />
      </div>
      <details class="topic-filter">
        <summary>
          Filtrar por assunto<span class="selected-topic"></span>
        </summary>
        <div class="filter-field">
          <label for="challenge-topic">Assunto</label>
          <select id="challenge-topic">
            <option value="">Todos os assuntos</option>
            {topics.map((topic) => (
              <option value={topic}>{topic}</option>
            ))}
          </select>
        </div>
      </details>
      <button type="reset">Limpar filtros</button>
      <p
        class="search-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></p>
    </form>
    <p class="empty-results" hidden>
      Nenhum desafio encontrado. Tente outro termo ou remova os filtros.
    </p>
    <section class="catalogue" aria-label="Desafios publicados">
      {challenges.map((challenge) => (
        <div
          data-challenge
          data-topics={JSON.stringify(challenge.data.topics)}
          data-search={challengeSearchText(challenge)}
        >
          <ChallengeCard challenge={challenge} headingLevel="h2" />
        </div>
      ))}
    </section>
    <section
      class="proposal"
      id="propor-desafio"
      aria-labelledby="proposal-heading"
      tabindex="-1"
    >
      <h2 id="proposal-heading">O próximo desafio pode começar com você.</h2>
      <p>
        Tem uma ideia para explorar computação e programação de sistemas?
        Qualquer pessoa pode propor um desafio abrindo um pull request no
        repositório <code>challenges</code>. Você também pode contribuir com
        melhorias nos enunciados e novos casos de teste.
      </p>
      <a class="button secondary" href={proposalGuideUrl}>
        Ver como propor no GitHub <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section class="testing-intro" aria-labelledby="testing-intro-heading">
      <h2 id="testing-intro-heading">Teste sua implementação</h2>
      <p>
        Use o <code>oxide-test</code> para executar os testes públicos no seu
        programa. O enunciado de cada desafio traz o comando correspondente.
      </p>
      <a class="text-link" href={runnerGuideUrl}>
        Ver instruções de instalação <span aria-hidden="true">↗</span>
      </a>
    </section>
    <section
      class="sharing"
      id="como-compartilhar"
      aria-labelledby="sharing-heading"
      tabindex="-1"
    >
      <div class="eyebrow">Participação</div>
      <h2 id="sharing-heading">Compartilhe sua tentativa ou descoberta</h2>
      <p class="sharing-intro">
        Você pode participar com uma dúvida, um caso de teste ou uma
        implementação em andamento. Compartilhe o que tentou e o que observou.
      </p>
      <div class="sharing-paths">
        <article>
          <h3>Converse no Discord</h3>
          <p>
            No canal #desafios, procure o tópico do desafio que você está
            explorando. Conte sua dúvida ou descoberta. Se ajudar, inclua um
            trecho de código, a entrada que testou e o resultado que observou.
          </p>
          <JoinLink label="Entrar no Discord" />
        </article>
        <article>
          <h3>Inclua sua implementação no catálogo</h3>
          <p>
            Publique o código em um repositório público seu. Depois, siga o guia
            no GitHub para enviar um pull request com o link da implementação.
            Ela pode estar completa ou em desenvolvimento; o código continua no
            seu repositório.
          </p>
          <a class="button secondary" href={contributeUrl}>
            Ver o guia no GitHub <span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  import { matchesChallenge } from '../../lib/challenge-search.mjs';
  const form = document.querySelector<HTMLFormElement>('.catalogue-filters')!;
  const query = form.querySelector<HTMLInputElement>('#challenge-query')!;
  const topic = form.querySelector<HTMLSelectElement>('#challenge-topic')!;
  const selectedTopic = form.querySelector<HTMLElement>('.selected-topic')!;
  const status = form.querySelector<HTMLElement>('.search-status')!;
  const empty = document.querySelector<HTMLElement>('.empty-results')!;
  const entries = Array.from(
    document.querySelectorAll<HTMLElement>('[data-challenge]'),
  ).map((element) => ({
    element,
    text: element.dataset.search ?? '',
    topics: JSON.parse(element.dataset.topics ?? '[]') as string[],
  }));
  function update() {
    let count = 0;
    for (const entry of entries) {
      const matches = matchesChallenge(
        entry.text,
        entry.topics,
        query.value,
        topic.value,
      );
      const newlyVisible = matches && Boolean(entry.element.hidden);
      entry.element.hidden = !matches;
      entry.element.classList.toggle('result-enter', newlyVisible);
      if (matches) count++;
    }
    selectedTopic.textContent = topic.value ? ` · ${topic.value}` : '';
    empty.hidden = count > 0;
    status.textContent = `${count} ${count === 1 ? 'desafio encontrado' : 'desafios encontrados'}`;
  }
  form.addEventListener('submit', (event) => event.preventDefault());
  query.addEventListener('input', update);
  topic.addEventListener('change', update);
  form.addEventListener('reset', () => {
    query.value = '';
    topic.value = '';
    update();
  });
  form.hidden = false;
  update();
</script>
<style>
  .page-intro {
    padding-block: 48px 32px;
  }
  .page-intro h1 {
    font-size: clamp(36px, 5vw, 56px);
  }
  .proposal-link {
    margin-top: 12px;
  }
  .proposal-link:is(:hover, :focus-visible) > span[aria-hidden] {
    transform: translateY(3px);
  }
  .proposal {
    border-top: 1px solid var(--color-border);
    padding-block: 36px;
  }
  .proposal h2 {
    max-width: 26ch;
    font-size: clamp(28px, 4vw, 36px);
  }
  .proposal p {
    max-width: 72ch;
    margin-block: 20px 24px;
  }
  .proposal code {
    font-family: var(--font-mono);
  }
  .catalogue-guidance {
    max-width: 88ch;
    margin-bottom: 24px;
  }
  .catalogue-guidance p {
    font-size: 15px;
  }
  .catalogue-guidance p + p {
    margin-top: 12px;
  }
  .testing-intro {
    border-top: 1px solid var(--color-border);
    padding-block: 28px;
  }
  .testing-intro h2 {
    font-size: 24px;
    margin-bottom: 12px;
  }
  .testing-intro p {
    max-width: 72ch;
    font-size: 15px;
  }
  .testing-intro code {
    font-family: var(--font-mono);
  }
  .catalogue-filters {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 12px 20px;
    margin-bottom: 24px;
  }
  .catalogue-filters > .filter-field {
    flex: 1 1 320px;
  }
  .topic-filter {
    flex: 0 1 300px;
    min-width: 0;
  }
  .topic-filter summary {
    cursor: pointer;
    padding: 10px 0;
    min-height: 44px;
    font-size: 14px;
  }
  .topic-filter .filter-field {
    margin-top: 12px;
  }
  .selected-topic {
    color: var(--color-accent-text);
  }
  [hidden] {
    display: none !important;
  }
  .filter-field {
    flex: 1 1 240px;
    min-width: 0;
  }
  label {
    display: block;
    margin-bottom: 8px;
    font-size: 13px;
  }
  input,
  select,
  button {
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    padding: 10px 12px;
  }
  input,
  select {
    width: 100%;
  }
  input::placeholder {
    color: var(--color-muted);
  }
  input:focus-visible,
  select:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
  button {
    cursor: pointer;
    font-size: 14px;
  }
  button:hover {
    border-color: var(--color-accent-text);
  }
  .search-status {
    flex-basis: 100%;
    font-size: 13px;
  }
  .empty-results {
    margin-bottom: 24px;
  }

  .catalogue {
    padding-bottom: 48px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .catalogue > div {
    min-width: 0;
  }
  @media (max-width: 1099px) {
    .catalogue {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .result-enter {
      animation: result-enter 180ms ease-out;
    }
  }
  @keyframes result-enter {
    from {
      transform: translateY(3px);
    }
    to {
      transform: translateY(0);
    }
  }
  .sharing {
    border-top: 1px solid var(--color-border);
    padding-block: 48px 80px;
  }
  .sharing .eyebrow {
    margin-bottom: 20px;
  }
  .sharing h2 {
    font-size: clamp(28px, 4vw, 40px);
    max-width: 24ch;
  }
  .sharing-intro {
    margin-top: 20px;
    max-width: 66ch;
  }
  .sharing-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 36px;
  }
  .sharing-paths article {
    min-width: 0;
  }
  .sharing-paths h3 {
    font-size: 22px;
  }
  .sharing-paths p {
    margin-block: 16px 24px;
    font-size: 15px;
  }
  @media (max-width: 700px) {
    .topic-filter {
      flex-basis: 150px;
    }
    .catalogue {
      grid-template-columns: minmax(0, 1fr);
    }
    .sharing-paths {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
