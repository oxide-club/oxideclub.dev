---
import TextLink from '../../components/ui/TextLink.astro';
import ButtonLink from '../../components/ui/ButtonLink.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogueBackToTop from '../../components/CatalogueBackToTop.astro';
import JoinLink from '../../components/JoinLink.astro';
import ChallengeCatalogueNav from '../../components/ChallengeCatalogueNav.astro';
import ChallengeAreaSection from '../../components/ChallengeAreaSection.astro';
import { githubUrl } from '../../config/github.mjs';
import { publishedChallenges } from '../../lib/challenges';
import { loadChallengeAreas } from '../../lib/challenge-areas.mjs';
import { challengesDirectory } from '../../lib/challenge-source.mjs';
import { groupChallengesByArea } from '../../lib/challenge-catalogue.mjs';
const challenges = await publishedChallenges();
const groups = groupChallengesByArea(
  challenges,
  await loadChallengeAreas(challengesDirectory()),
);
const startingChallenge = challenges.find(({ id }) => id === '001-wc');
const contributeUrl = `${githubUrl('solutions', 'CONTRIBUTING.md', 'blob')}#compartilhar-uma-implementação`;
const runnerGuideUrl = githubUrl('challenges', 'docs/runner.md', 'blob');
const proposalGuideUrl = githubUrl('challenges', 'CONTRIBUTING.md', 'blob');
---

<BaseLayout
  title="Desafios"
  description="Explore desafios de programação por área de interesse: sistemas, algoritmos, gráficos, formatos binários, memória e interpretadores."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Desafios · Computação na prática</div>
      <h1>O que você quer explorar?</h1>
      <p>
        Encontre uma área que desperte sua curiosidade. Escolha um programa para
        construir, investigar ou depurar.
      </p>
    </header>
    <p class="catalogue-guidance">
      Para investigar uma pergunta com experimentos, conheça os{' '}
      <a href="/labs/">laboratórios</a>.
    </p>
    <ChallengeCatalogueNav
      active="areas"
      areaCount={groups.length}
      challengeCount={challenges.length}
    />
    <nav class="area-index" aria-label="Áreas de interesse">
      {groups.map(({ area, challenges }) => (
        <a href={`#${area.slug}`}>
          {area.title}
          <span>
            {String(challenges.length).padStart(2, '0')}{' '}
            <span aria-hidden="true">↓</span>
          </span>
        </a>
      ))}
    </nav>
    {startingChallenge && (
      <p class="catalogue-guidance">
        <strong>Primeiro desafio?</strong> O{' '}
        <a href={`/desafios/${startingChallenge.data.slug}`}>wc</a> é uma
        sugestão para quem já conhece variáveis, laços e como compilar um
        programa em C. Precisa se preparar? Consulte a{' '}
        <a href="/biblioteca#programacao-em-c">biblioteca de C</a>.
      </p>
    )}
    <div class="area-catalogue">
      {groups.map((group) => (
        <ChallengeAreaSection {...group} />
      ))}
    </div>
    <section
      class="proposal"
      id="propor-desafio"
      aria-labelledby="proposal-heading"
      tabindex="-1"
    >
      <h2 id="proposal-heading">O próximo desafio pode começar com você.</h2>
      <p>
        Tem uma ideia para explorar computação e programação de sistemas?
        Qualquer pessoa pode propor um desafio abrindo um pull request no
        repositório <code>challenges</code>. Você também pode contribuir com
        melhorias nos enunciados e novos casos de teste.
      </p>
      <ButtonLink variant="secondary" href={proposalGuideUrl}>
        Ver como propor no GitHub <span aria-hidden="true">↗</span>
      </ButtonLink>
    </section>
    <section class="testing-intro" aria-labelledby="testing-intro-heading">
      <h2 id="testing-intro-heading">Teste sua implementação</h2>
      <p>
        Use o <code>oxide-test</code> para executar os testes públicos no seu
        programa. O enunciado de cada desafio traz o comando correspondente.
      </p>
      <TextLink href={runnerGuideUrl}>
        Ver instruções de instalação <span aria-hidden="true">↗</span>
      </TextLink>
    </section>
    <section
      class="sharing"
      id="como-compartilhar"
      aria-labelledby="sharing-heading"
      tabindex="-1"
    >
      <div class="eyebrow">Participação</div>
      <h2 id="sharing-heading">Compartilhe sua tentativa ou descoberta</h2>
      <p class="sharing-intro">
        Você pode participar com uma dúvida, um caso de teste ou uma
        implementação em andamento. Compartilhe o que tentou e o que observou.
      </p>
      <div class="sharing-paths">
        <article>
          <h3>Converse no Discord</h3>
          <p>
            No canal #desafios, procure o tópico do desafio que você está
            explorando. Conte sua dúvida ou descoberta. Se ajudar, inclua um
            trecho de código, a entrada que testou e o resultado que observou.
          </p>
          <JoinLink label="Entrar no Discord" />
        </article>
        <article>
          <h3>Inclua sua implementação no catálogo</h3>
          <p>
            Publique o código em um repositório público seu. Depois, siga o guia
            no GitHub para enviar um pull request com o link da implementação.
            Ela pode estar completa ou em desenvolvimento; o código continua no
            seu repositório.
          </p>
          <ButtonLink variant="secondary" href={contributeUrl}>
            Ver o guia no GitHub <span aria-hidden="true">↗</span>
          </ButtonLink>
        </article>
      </div>
    </section>
  </div>
  <CatalogueBackToTop targetId="catalogue-top" />
</BaseLayout>
<style>
  .page-intro {
    padding-block: var(--space-12) var(--space-8);
  }
  .page-intro h1 {
    font-size: clamp(34px, 5vw, 56px);
    max-width: 20ch;
  }
  .page-intro p {
    max-width: 66ch;
    margin-top: var(--space-5);
  }
  .area-index {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--space-7);
    padding-block: var(--space-5) var(--space-7);
  }
  .area-index > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 60px;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--text-control);
    text-decoration: none;
  }
  .area-index > a:hover {
    text-decoration: underline;
  }
  .area-index > a > span {
    font: 12px var(--font-mono);
    color: var(--color-muted);
    white-space: nowrap;
  }
  .catalogue-guidance {
    font-size: var(--text-control);
    padding-bottom: var(--space-8);
    max-width: 88ch;
  }
  .catalogue-guidance strong {
    color: var(--color-text);
  }
  .proposal {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-9);
  }
  .proposal h2 {
    max-width: 26ch;
    font-size: clamp(28px, 4vw, 36px);
  }
  .proposal p {
    max-width: var(--reading-width);
    margin-block: var(--space-5) var(--space-6);
  }
  .proposal code {
    font-family: var(--font-mono);
  }
  .testing-intro {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-7);
  }
  .testing-intro h2 {
    font-size: var(--text-card-title);
    margin-bottom: var(--space-3);
  }
  .testing-intro p {
    max-width: var(--reading-width);
    font-size: var(--text-summary);
  }
  .testing-intro code {
    font-family: var(--font-mono);
  }
  .sharing {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-12) var(--space-20);
  }
  .sharing .eyebrow {
    margin-bottom: var(--space-5);
  }
  .sharing h2 {
    font-size: clamp(28px, 4vw, 40px);
    max-width: 24ch;
  }
  .sharing-intro {
    margin-top: var(--space-5);
    max-width: 66ch;
  }
  .sharing-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-10);
    margin-top: var(--space-9);
  }
  .sharing-paths article {
    min-width: 0;
  }
  .sharing-paths h3 {
    font-size: 22px;
  }
  .sharing-paths p {
    margin-block: var(--space-4) var(--space-6);
    font-size: var(--text-summary);
  }
  @media (max-width: 650px) {
    .area-index {
      grid-template-columns: minmax(0, 1fr);
      padding-block: var(--space-3) var(--space-6);
    }
    .area-index > a {
      min-height: var(--action-height);
    }
    .sharing-paths {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
