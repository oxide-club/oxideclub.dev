---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChallengeCard from '../../components/ChallengeCard.astro';
import JoinLink from '../../components/JoinLink.astro';
import { githubUrl } from '../../config/github.mjs';
import { publishedChallenges } from '../../lib/challenges';
import { ascendingChallenges } from '../../lib/challenge-catalogue.mjs';
import { categoryLabels } from '../../lib/challenge-taxonomy.mjs';
const challenges = ascendingChallenges(await publishedChallenges());
const contributeUrl = `${githubUrl('solutions', 'CONTRIBUTING.md', 'blob')}#compartilhar-uma-implementação`;
const runnerGuideUrl = githubUrl('challenges', 'docs/runner.md', 'blob');
const topics = [...new Set(challenges.flatMap(({ data }) => data.topics))].sort(
  (a, b) => a.localeCompare(b, 'pt-BR'),
);
---

<BaseLayout
  title="Desafios"
  description="Desafios públicos de computação e programação de sistemas: implemente, depure, meça desempenho e discuta hipóteses e decisões de engenharia."
>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Laboratório aberto / Desafios</div>
      <h1>
        Desafios de programação.
        <br />
        <span class="accent">Escolha por onde começar.</span>
      </h1>
      <p>
        Escolha um desafio pelo assunto que desperta sua curiosidade e confira a
        dificuldade e a linguagem recomendada. Traga suas dúvidas e soluções
        parciais para conversar no Discord.
      </p>
    </header>
    <section class="testing-intro" aria-labelledby="testing-intro-heading">
      <h2 id="testing-intro-heading">Teste sua solução</h2>
      <p>
        O <code>oxide-test</code> executa os testes públicos dos desafios no seu
        programa compilado. Use Linux, Windows com WSL 2 ou Docker; no macOS,
        use Docker. Cada desafio traz o comando para testar sua implementação.
      </p>
      <a class="text-link" href={runnerGuideUrl}>
        Instalar e usar o oxide-test <span aria-hidden="true">↗</span>
      </a>
    </section>
    <form
      class="catalogue-filters"
      role="search"
      aria-label="Buscar desafios"
      hidden
    >
      <div class="filter-field">
        <label for="challenge-query">Buscar desafios</label>
        <input
          id="challenge-query"
          type="search"
          placeholder="Título, assunto ou linguagem"
          autocomplete="off"
        />
      </div>
      <div class="filter-field">
        <label for="challenge-topic">Assunto</label>
        <select id="challenge-topic">
          <option value="">Todos os assuntos</option>
          {topics.map((topic) => (
            <option value={topic}>{topic}</option>
          ))}
        </select>
      </div>
      <button type="reset">Limpar filtros</button>
      <p
        class="search-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></p>
    </form>
    <p class="empty-results" hidden>
      Nenhum desafio encontrado. Tente outro termo ou remova os filtros.
    </p>
    <section class="catalogue" aria-label="Desafios publicados">
      {challenges.map((challenge) => (
        <div
          data-challenge
          data-topics={JSON.stringify(challenge.data.topics)}
          data-search={[
            challenge.id,
            challenge.data.title,
            challenge.data.summary,
            ...challenge.data.topics,
            ...challenge.data.categories.map(
              (category) => categoryLabels[category],
            ),
            challenge.data.recommendedLanguage ?? '',
          ].join(' ')}
        >
          <ChallengeCard challenge={challenge} headingLevel="h2" />
        </div>
      ))}
    </section>
    <div class="catalogue-note">
      <h2>Diferentes caminhos de investigação.</h2>
      <p>
        A dificuldade indica os conhecimentos envolvidos, não quem pode
        participar. As extensões de cada desafio são opcionais.
      </p>
    </div>
    <section
      class="sharing"
      id="como-compartilhar"
      aria-labelledby="sharing-heading"
      tabindex="-1"
    >
      <div class="eyebrow">Participação</div>
      <h2 id="sharing-heading">Como compartilhar sua descoberta</h2>
      <p class="sharing-intro">
        Não é necessário concluir um desafio para participar. Dúvidas, casos de
        teste, tentativas e soluções parciais também são bem-vindos.
      </p>
      <div class="sharing-paths">
        <article>
          <h3>Converse no Discord</h3>
          <p>
            No canal #desafios, procure o tópico do desafio que você está
            explorando. Conte sua dúvida ou descoberta. Se ajudar, inclua um
            trecho de código, a entrada que testou e o resultado que observou.
          </p>
          <JoinLink label="Conversar no Discord" />
        </article>
        <article>
          <h3>Inclua sua implementação no catálogo</h3>
          <p>
            Publique o código em um repositório público seu. Depois, siga o guia
            no GitHub para enviar um pull request com o link da implementação.
            Ela pode estar completa ou em desenvolvimento; o código continua no
            seu repositório.
          </p>
          <a class="button secondary" href={contributeUrl}>
            Ver o guia no GitHub <span aria-hidden="true">↗</span>
          </a>
        </article>
      </div>
    </section>
  </div>
</BaseLayout>
<script>
  import { matchesChallenge } from '../../lib/challenge-catalogue.mjs';
  const form = document.querySelector<HTMLFormElement>('.catalogue-filters')!;
  const query = form.querySelector<HTMLInputElement>('#challenge-query')!;
  const topic = form.querySelector<HTMLSelectElement>('#challenge-topic')!;
  const status = form.querySelector<HTMLElement>('.search-status')!;
  const empty = document.querySelector<HTMLElement>('.empty-results')!;
  const entries = Array.from(
    document.querySelectorAll<HTMLElement>('[data-challenge]'),
  ).map((element) => ({
    element,
    text: element.dataset.search ?? '',
    topics: JSON.parse(element.dataset.topics ?? '[]') as string[],
  }));
  function update() {
    let count = 0;
    for (const entry of entries) {
      const matches = matchesChallenge(
        entry.text,
        entry.topics,
        query.value,
        topic.value,
      );
      const newlyVisible = matches && Boolean(entry.element.hidden);
      entry.element.hidden = !matches;
      entry.element.classList.toggle('result-enter', newlyVisible);
      if (matches) count++;
    }
    empty.hidden = count > 0;
    status.textContent = `${count} ${count === 1 ? 'desafio encontrado' : 'desafios encontrados'}`;
  }
  form.addEventListener('submit', (event) => event.preventDefault());
  query.addEventListener('input', update);
  topic.addEventListener('change', update);
  form.addEventListener('reset', () => {
    query.value = '';
    topic.value = '';
    update();
  });
  form.hidden = false;
  update();
</script>
<style>
  .testing-intro {
    padding: 24px;
    margin-bottom: 32px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }
  .testing-intro h2 {
    font-size: 24px;
    margin-bottom: 12px;
  }
  .testing-intro p {
    max-width: 72ch;
    font-size: 15px;
    margin-bottom: 12px;
  }
  .testing-intro code {
    font-family: var(--font-mono);
  }
  .catalogue-filters {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
  }
  [hidden] {
    display: none !important;
  }
  .filter-field {
    flex: 1 1 240px;
    min-width: 0;
  }
  label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
  }
  input,
  select,
  button {
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    padding: 10px 12px;
  }
  input,
  select {
    width: 100%;
  }
  input::placeholder {
    color: var(--color-muted);
  }
  input:focus-visible,
  select:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 4px;
  }
  button {
    cursor: pointer;
    font-size: 14px;
  }
  button:hover {
    border-color: var(--color-accent-text);
  }
  .search-status {
    flex-basis: 100%;
    font-size: 13px;
  }
  .empty-results {
    margin-bottom: 24px;
  }

  .catalogue {
    padding-bottom: 48px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .catalogue > div {
    min-width: 0;
  }
  @media (max-width: 1099px) {
    .catalogue {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .result-enter {
      animation: result-enter 180ms ease-out;
    }
  }
  @keyframes result-enter {
    from {
      transform: translateY(3px);
    }
    to {
      transform: translateY(0);
    }
  }
  .catalogue-note {
    max-width: 680px;
    padding-bottom: 48px;
  }
  .catalogue-note h2 {
    font-size: 28px;
    margin-bottom: 16px;
  }
  .catalogue-note p {
    font-size: 15px;
  }
  .sharing {
    border-top: 1px solid var(--color-border);
    padding-block: 48px 80px;
  }
  .sharing .eyebrow {
    margin-bottom: 20px;
  }
  .sharing h2 {
    font-size: clamp(28px, 4vw, 40px);
    max-width: 24ch;
  }
  .sharing-intro {
    margin-top: 20px;
    max-width: 66ch;
  }
  .sharing-paths {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
    margin-top: 36px;
  }
  .sharing-paths article {
    min-width: 0;
  }
  .sharing-paths h3 {
    font-size: 22px;
  }
  .sharing-paths p {
    margin-block: 16px 24px;
    font-size: 15px;
  }
  @media (max-width: 700px) {
    .catalogue {
      grid-template-columns: minmax(0, 1fr);
    }
    .sharing-paths {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
