---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChallengeResources from '../../components/ChallengeResources.astro';
import ChallengeTesting from '../../components/ChallengeTesting.astro';
import CommunityImplementations from '../../components/CommunityImplementations.astro';
import { loadCommunity } from '../../lib/community';
import JoinLink from '../../components/JoinLink.astro';
import { categoryLabels } from '../../lib/challenge-taxonomy.mjs';
import { publishedChallenges, difficultyLabels } from '../../lib/challenges';
export async function getStaticPaths() {
  const catalogues = await loadCommunity();
  return (await publishedChallenges()).map((challenge) => ({
    params: { slug: challenge.data.slug },
    props: { challenge, implementations: catalogues.get(challenge.id) ?? [] },
  }));
}
interface Props {
  challenge: CollectionEntry<'challenges'>;
  implementations: import('../../lib/community').CommunityImplementation[];
}
const { challenge, implementations } = Astro.props;
const { Content, headings } = await render(challenge);
const { data } = challenge;
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="container">
    <header class="page-intro">
      <a class="text-link" href="/desafios">
        ← Todos os desafios
      </a>
      <div class="eyebrow">
        {difficultyLabels[data.difficulty]}
        {data.recommendedLanguage && ` / ${data.recommendedLanguage}`} / Desafio
        prático
      </div>
      <h1>
        {data.title}
        <span class="accent">_</span>
      </h1>
      <p>{data.summary}</p>
      <div class="actions participation-actions">
        <JoinLink
          href={data.discordThreadUrl}
          label="Conversar sobre a solução no Discord"
        />
        {data.eventUrl && (
          <a class="text-link" href={data.eventUrl}>
            Ver evento no Discord <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
      <p class="categories">
        Categorias:{' '}
        {data.categories
          .map((category) => categoryLabels[category])
          .join(' · ')}
      </p>
      <div class="metadata">
        {data.environment && <span class="tag">{data.environment}</span>}
        <span>
          Publicado em{' '}
          {data.publishedAt.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
        </span>
        {data.updatedAt && (
          <span>
            Atualizado em{' '}
            {data.updatedAt.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
          </span>
        )}
      </div>
    </header>
    <div class="article-layout">
      <article class="prose">
        <Content />
        <ChallengeTesting challengeId={challenge.id} />
        <ChallengeResources challengeId={challenge.id} github={data.github} />
        <CommunityImplementations
          implementations={implementations}
          discordThreadUrl={data.discordThreadUrl}
        />
      </article>
      <aside>
        <nav aria-label="Nesta especificação">
          <span class="eyebrow">Nesta especificação</span>
          {headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
          <a href="#challenge-testing-heading">Teste sua implementação</a>
        </nav>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .page-intro > .text-link {
    margin-bottom: 24px;
  }
  .page-intro > .categories {
    font-size: 13px;
    margin-top: 20px;
  }
  .participation-actions {
    margin-top: 24px;
    align-items: center;
  }
  .metadata {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
    font: 10px var(--font-mono);
    color: var(--color-muted);
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 72px;
    padding-bottom: 80px;
    border-top: 1px solid var(--color-border);
  }
  aside {
    padding-top: 48px;
  }
  aside nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  aside nav .eyebrow {
    margin-bottom: 16px;
  }
  aside nav a {
    font-size: 12px;
    color: var(--color-muted);
    padding-block: 7px;
    text-decoration: none;
  }
  aside nav a:hover {
    text-decoration: underline;
    color: var(--color-text);
  }
  @media (max-width: 800px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .article-layout aside {
      padding-top: 32px;
    }
    aside nav {
      display: none;
    }
    .metadata {
      font-size: 11px;
    }
  }
</style>
