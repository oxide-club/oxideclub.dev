---
import TextLink from '../../components/ui/TextLink.astro';
import ReadingLayout from '../../components/ui/ReadingLayout.astro';
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChallengeIndex from '../../components/ChallengeIndex.astro';
import { challengeResources } from '../../lib/challenge-resources.mjs';
import ChallengeResources from '../../components/ChallengeResources.astro';
import ChallengeTesting from '../../components/ChallengeTesting.astro';
import CommunityImplementations from '../../components/CommunityImplementations.astro';
import { loadCommunity } from '../../lib/community';
import JoinLink from '../../components/JoinLink.astro';
import { challengeLanguages } from '../../lib/challenge-languages.mjs';
import { categoryLabels } from '../../lib/challenge-taxonomy.mjs';
import { publishedChallenges, difficultyLabels } from '../../lib/challenges';
import { loadChallengeAreas } from '../../lib/challenge-areas.mjs';
import { challengesDirectory } from '../../lib/challenge-source.mjs';
export async function getStaticPaths() {
  const catalogues = await loadCommunity();
  return (await publishedChallenges()).map((challenge) => ({
    params: { slug: challenge.data.slug },
    props: { challenge, implementations: catalogues.get(challenge.id) ?? [] },
  }));
}
interface Props {
  challenge: CollectionEntry<'challenges'>;
  implementations: import('../../lib/community').CommunityImplementation[];
}
const { challenge, implementations } = Astro.props;
const { Content, headings } = await render(challenge);
const { data } = challenge;
const area = (await loadChallengeAreas(challengesDirectory())).find(
  (area) => area.id === data.area,
)!;
const resources = challengeResources(challenge.id, data.github);
const indexLinks = [
  ...headings
    .filter(({ depth }) => depth === 2)
    .map(({ slug, text }) => ({ href: `#${slug}`, text })),
  { href: '#challenge-testing-heading', text: 'Teste sua implementação' },
  ...(resources.challenge || resources.solutions.length
    ? [
        {
          href: '#challenge-resources-heading',
          text: 'Recursos e implementações',
        },
      ]
    : []),
  {
    href: '#community-implementations-heading',
    text: 'Implementações da comunidade',
  },
];
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="container">
    <header class="page-intro">
      <TextLink href="/desafios">← Todos os desafios</TextLink>
      <div class="eyebrow">
        {difficultyLabels[data.difficulty]}
        {challengeLanguages(data).length > 0 &&
          ` / ${challengeLanguages(data).join(' · ')}`}{' '}
        / Desafio prático
      </div>
      <h1>
        {data.title}
        <span class="accent">_</span>
      </h1>
      <p>{data.summary}</p>
      <p class="challenge-area">
        Área: <a href={`/desafios#${area.slug}`}>{area.title}</a>
      </p>
      {data.recommendedLanguage && challengeLanguages(data).length > 1 && (
        <p class="language-recommendation">
          Recomendação: {data.recommendedLanguage}
        </p>
      )}
      <div class="actions participation-actions">
        <JoinLink
          href={data.discordThreadUrl}
          label="Conversar sobre a solução no Discord"
        />
        {data.eventUrl && (
          <TextLink href={data.eventUrl}>
            Ver evento no Discord <span aria-hidden="true">↗</span>
          </TextLink>
        )}
      </div>
      <p class="categories">
        Categorias:{' '}
        {data.categories
          .map((category) => categoryLabels[category])
          .join(' · ')}
      </p>
      <div class="metadata">
        {data.environment && <span class="tag">{data.environment}</span>}
        <span>
          Publicado em{' '}
          {data.publishedAt.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
        </span>
        {data.updatedAt && (
          <span>
            Atualizado em{' '}
            {data.updatedAt.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
          </span>
        )}
      </div>
    </header>
    {challenge.id === '001-wc' && (
      <aside class="preparation" aria-label="Antes de começar">
        <strong>Antes de começar</strong>
        <p>
          Este desafio pressupõe variáveis, laços e compilação de programas em
          C. Para se preparar, consulte a{' '}
          <a href="/biblioteca#programacao-em-c">biblioteca de C</a>. Você pode
          participar da conversa enquanto aprende.
        </p>
      </aside>
    )}
    <ReadingLayout label="Neste desafio" variant="challenge">
      <ChallengeIndex links={indexLinks} slot="index" />
      <Content />
      <ChallengeTesting challengeId={challenge.id} />
      <ChallengeResources challengeId={challenge.id} github={data.github} />
      <CommunityImplementations
        implementations={implementations}
        discordThreadUrl={data.discordThreadUrl}
      />
    </ReadingLayout>
  </div>
</BaseLayout>
<style>
  .page-intro .language-recommendation {
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  .page-intro > .text-link {
    margin-bottom: var(--space-6);
  }
  .page-intro > .categories {
    font-size: var(--text-sm);
    margin-top: var(--space-5);
  }
  .participation-actions {
    margin-top: var(--space-6);
    align-items: center;
  }
  .metadata {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font: 13px var(--font-mono);
    color: var(--color-muted);
  }
  .preparation {
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-6);
    border-left: 2px solid var(--color-accent);
    background: var(--color-surface);
    max-width: var(--reading-width);
  }
  .preparation p {
    margin-top: var(--space-2);
    font-size: var(--text-summary);
  }
  @media (max-width: 800px) {
    .metadata {
      font-size: var(--text-sm);
    }
  }
</style>
