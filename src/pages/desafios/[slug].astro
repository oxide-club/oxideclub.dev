---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChallengeResources from '../../components/ChallengeResources.astro';
import JoinLink from '../../components/JoinLink.astro';
import { categoryLabels } from '../../lib/challenge-taxonomy.mjs';
import { publishedChallenges, difficultyLabels } from '../../lib/challenges';
export async function getStaticPaths() {
  return (await publishedChallenges()).map((challenge) => ({
    params: { slug: challenge.data.slug },
    props: { challenge },
  }));
}
interface Props {
  challenge: CollectionEntry<'challenges'>;
}
const { challenge } = Astro.props;
const { Content, headings } = await render(challenge);
const { data } = challenge;
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="container">
    <header class="page-intro">
      <a class="text-link" href="/desafios">
        ← Todos os desafios
      </a>
      <div class="eyebrow">
        {difficultyLabels[data.difficulty]}
        {data.recommendedLanguage && ` / ${data.recommendedLanguage}`} / Desafio
        prático
      </div>
      <h1>
        {data.title}
        <span class="accent">_</span>
      </h1>
      <p>{data.summary}</p>
      <p class="categories">
        Categorias:{' '}
        {data.categories
          .map((category) => categoryLabels[category])
          .join(' · ')}
      </p>
      <div class="metadata">
        {data.environment && <span class="tag">{data.environment}</span>}
        <span>
          Publicado em{' '}
          {data.publishedAt.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
        </span>
        {data.updatedAt && (
          <span>
            Atualizado em{' '}
            {data.updatedAt.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}
          </span>
        )}
      </div>
    </header>
    <div class="article-layout">
      <article class="prose">
        <Content />
        <ChallengeResources challengeId={challenge.id} github={data.github} />
      </article>
      <aside>
        <nav aria-label="Nesta especificação">
          <span class="eyebrow">Nesta especificação</span>
          {headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => (
              <a href={`#${heading.slug}`}>{heading.text}</a>
            ))}
        </nav>
        <div class="discussion">
          <h2>Leve a investigação adiante.</h2>
          <p>
            Compartilhe perguntas, código, medições ou observações e explique o
            que descobriu. Discuta abordagens, limites dos testes e questões em
            aberto com a comunidade.
          </p>
          {data.discordThreadUrl ? (
            <a class="button" href={data.discordThreadUrl}>
              Discutir este desafio ↗
            </a>
          ) : (
            <JoinLink label="Conversar no Discord" />
          )}
          {data.eventUrl && (
            <a class="text-link" href={data.eventUrl}>
              Ver evento no Discord ↗
            </a>
          )}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .page-intro > .text-link {
    margin-bottom: 24px;
  }
  .page-intro > .categories {
    font-size: 13px;
    margin-top: 20px;
  }
  .metadata {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 24px;
    font: 10px var(--font-mono);
    color: var(--color-muted);
  }
  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 72px;
    padding-bottom: 80px;
    border-top: 1px solid var(--color-border);
  }
  aside {
    padding-top: 48px;
  }
  aside nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  aside nav .eyebrow {
    margin-bottom: 16px;
  }
  aside nav a {
    font-size: 12px;
    color: var(--color-muted);
    padding-block: 7px;
    text-decoration: none;
  }
  aside nav a:hover {
    text-decoration: underline;
    color: var(--color-text);
  }
  .discussion {
    margin-top: 32px;
    padding: 24px;
    background: var(--color-surface);
    border-radius: 8px;
  }
  .discussion h2 {
    font-size: 22px;
    margin-bottom: 16px;
  }
  .discussion p {
    font-size: 12px;
    margin-bottom: 24px;
  }
  .discussion :global(.button) {
    font-size: 12px;
    padding: 12px;
    gap: 10px;
  }
  @media (max-width: 800px) {
    .article-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .article-layout aside {
      padding-top: 32px;
    }
    aside nav {
      display: none;
    }
    .discussion {
      margin-top: 0;
    }
    .metadata {
      font-size: 11px;
    }
  }
</style>
