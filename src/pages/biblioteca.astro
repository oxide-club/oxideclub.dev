---
import Button from '../components/ui/Button.astro';
import Select from '../components/ui/Select.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { libraryCategories } from '../lib/library';

const resourceCount = libraryCategories.reduce(
  (count, category) => count + category.resources.length,
  0,
);
const description =
  'Uma coleção de livros, cursos e referências para estudar os fundamentos da computação e da programação de sistemas.';
const availabilityLabels = { gratuito: 'Gratuito', comercial: 'Comercial' };
const languageLabels = { EN: 'Inglês', 'PT-BR': 'Português do Brasil' };
---

<BaseLayout title="Biblioteca" description={description}>
  <div class="container">
    <header class="page-intro">
      <div class="eyebrow">Oxide Club / Referências</div>
      <h1>
        Biblioteca{' '}
        <span class="accent" aria-hidden="true">
          _
        </span>
      </h1>
      <p>{description}</p>
    </header>
    <div class="library-layout">
      <aside class="library-sidebar">
        <p class="index-label" id="library-index-label">
          Nesta página
        </p>
        <nav aria-labelledby="library-index-label">
          <ul>
            {libraryCategories.map((category) => (
              <li>
                <a href={`#${category.id}`}>{category.title}</a>
              </li>
            ))}
          </ul>
        </nav>
        <p class="index-note">
          {resourceCount} recursos · {libraryCategories.length} categorias
          <br />
          EN: inglês · PT-BR: português
        </p>
      </aside>
      <div class="library-resources">
        <details class="library-index" id="library-index">
          <summary>
            Categorias
            <span>{libraryCategories.length} assuntos</span>
          </summary>
          <nav aria-label="Categorias da biblioteca">
            <ul>
              {libraryCategories.map((category) => (
                <li>
                  <a href={`#${category.id}`}>{category.title}</a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
        <p class="curation-note">
          Em cada assunto, “Por onde começar” indica uma sugestão de entrada.
          Use as descrições para escolher entre estudar um tema e consultar uma
          referência.
        </p>
        <form class="library-filters" aria-label="Filtrar biblioteca" hidden>
          <div>
            <label for="library-language">Idioma</label>
            <Select id="library-language">
              <option value="">Todos os idiomas</option>
              <option value="PT-BR">Português</option>
              <option value="EN">Inglês</option>
            </Select>
          </div>
          <div>
            <label for="library-availability">Disponibilidade</label>
            <Select id="library-availability">
              <option value="">Todas</option>
              <option value="gratuito">Gratuito</option>
              <option value="comercial">Comercial</option>
            </Select>
          </div>
          <Button type="reset" variant="quiet">
            Limpar filtros
          </Button>
          <p
            role="status"
            aria-live="polite"
            aria-atomic="true"
            class="filter-status"
          ></p>
        </form>
        <p class="empty-library" hidden>
          Nenhum recurso encontrado. Selecione outro idioma ou limpe os filtros.
        </p>
        {libraryCategories.map((category) => (
          <section
            class="library-category"
            id={category.id}
            aria-labelledby={`${category.id}-heading`}
            tabindex="-1"
          >
            <h2 id={`${category.id}-heading`}>{category.title}</h2>
            <ul role="list">
              {category.resources.map((resource) => (
                <li
                  data-language={resource.language}
                  data-availability={resource.availability}
                >
                  <a href={resource.url}>{resource.title}</a>
                  <span class="resource-meta">
                    {resource.type} ·{' '}
                    {resource.author && `${resource.author} · `}
                    <abbr title={languageLabels[resource.language]}>
                      {resource.language}
                    </abbr>
                    {' · '}
                    {availabilityLabels[resource.availability]}
                    {resource.note && ` · ${resource.note}`}
                  </span>
                  <p class="resource-guidance">
                    {resource.startingPoint && (
                      <strong>Por onde começar · </strong>
                    )}
                    {resource.guidance}
                  </p>
                </li>
              ))}
            </ul>
            <a class="category-return text-link" href="#library-index">
              Voltar às categorias <span aria-hidden="true">↑</span>
            </a>
          </section>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const sections = [
    ...document.querySelectorAll<HTMLElement>('.library-category'),
  ];
  const indexLinks = [
    ...document.querySelectorAll<HTMLAnchorElement>(
      '.library-sidebar nav a, .library-index nav a',
    ),
  ];
  const form = document.querySelector<HTMLFormElement>('.library-filters')!;
  const language = form.querySelector<HTMLSelectElement>('#library-language')!;
  const availability = form.querySelector<HTMLSelectElement>(
    '#library-availability',
  )!;
  const status = form.querySelector<HTMLElement>('.filter-status')!;
  function filterResources() {
    let count = 0;
    for (const section of sections) {
      let sectionCount = 0;
      for (const resource of section.querySelectorAll<HTMLElement>(
        'li[data-language]',
      )) {
        const matches =
          (!language.value || resource.dataset.language === language.value) &&
          (!availability.value ||
            resource.dataset.availability === availability.value);
        resource.hidden = !matches;
        if (matches) sectionCount++;
      }
      section.hidden = sectionCount === 0;
      count += sectionCount;
      for (const link of indexLinks.filter(
        (link) => link.hash === `#${section.id}`,
      )) {
        link.closest('li')!.hidden = section.hidden;
      }
    }
    status.textContent = `${count} ${count === 1 ? 'recurso encontrado' : 'recursos encontrados'}`;
    document.querySelector<HTMLElement>('.empty-library')!.hidden = count > 0;
    scheduleUpdate();
  }
  form.addEventListener('submit', (event) => event.preventDefault());
  form.addEventListener('change', filterResources);
  form.addEventListener('reset', () => {
    language.value = '';
    availability.value = '';
    filterResources();
  });
  form.hidden = false;
  let scheduled = false;
  let currentId = '';

  function updateIndex() {
    scheduled = false;
    // Track the section at the reading line, including the final short section.
    const readingLine = Math.min(160, window.innerHeight * 0.25);
    const visibleSections = sections.filter((section) => !section.hidden);
    let current = visibleSections[0];
    for (const section of visibleSections) {
      if (section.getBoundingClientRect().top <= readingLine) current = section;
    }
    if (
      window.scrollY + window.innerHeight >=
      document.documentElement.scrollHeight - 2
    ) {
      current = visibleSections[visibleSections.length - 1];
    }
    if ((current?.id ?? '') === currentId) return;
    currentId = current?.id ?? '';
    for (const link of indexLinks) {
      if (link.hash === `#${currentId}`)
        link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }

  function scheduleUpdate() {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(updateIndex);
  }

  window.addEventListener('scroll', scheduleUpdate, { passive: true });
  window.addEventListener('resize', scheduleUpdate);
  window.addEventListener('pageshow', scheduleUpdate);
  document
    .querySelector('.library-index')
    ?.addEventListener('toggle', scheduleUpdate);
  document.fonts.ready.then(scheduleUpdate);
  filterResources();
</script>

<style>
  [hidden] {
    display: none !important;
  }
  .curation-note {
    margin-bottom: var(--space-5);
    font-size: var(--text-summary);
  }
  .library-filters {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .library-filters > div {
    flex: 1 1 180px;
    min-width: 0;
  }
  .library-filters label {
    display: block;
    font-size: var(--text-control);
    margin-bottom: var(--space-2);
  }
  .filter-status {
    flex-basis: 100%;
    font-size: var(--text-control);
  }
  .resource-guidance {
    flex-basis: 100%;
    font-size: var(--text-control);
    margin-top: var(--space-1);
  }
  .resource-guidance strong {
    color: var(--color-text);
    font-weight: 550;
  }

  .library-layout {
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: var(--space-16);
    padding-block: var(--space-10) var(--space-20);
  }
  .library-sidebar {
    align-self: start;
  }
  /* The index scrolls independently when enlarged text exceeds the viewport. */
  @media (min-width: 901px) {
    .library-sidebar {
      position: sticky;
      top: 32px;
      max-height: calc(100dvh - 64px);
      overflow-y: auto;
      padding: var(--space-2);
      margin: -8px;
    }
  }
  .index-label {
    font: 13px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-5);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .library-sidebar li + li {
    margin-top: var(--space-2);
  }
  .library-sidebar a {
    display: block;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.6;
    text-decoration: none;
    color: var(--color-muted);
  }
  .library-sidebar a:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
  }
  .library-sidebar nav a,
  .library-index nav a {
    border-left: 2px solid transparent;
    padding-left: var(--space-3);
    transition:
      color var(--motion-fast) var(--motion-easing),
      border-color var(--motion-fast) var(--motion-easing);
  }
  .library-sidebar a[aria-current='location'],
  .library-index a[aria-current='location'] {
    border-left-color: var(--color-accent);
    color: var(--color-accent-text);
  }
  .library-category:target h2 {
    color: var(--color-accent-text);
  }
  @media (prefers-reduced-motion: no-preference) {
    .library-category:target h2 {
      animation: category-arrive 700ms ease-out;
    }
  }
  @keyframes category-arrive {
    from {
      background-color: var(--color-highlight);
    }
    to {
      background-color: transparent;
    }
  }
  .index-note {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    font: 13px/1.8 var(--font-mono);
  }
  .library-resources {
    min-width: 0;
  }
  .library-category + .library-category {
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }
  .library-category h2 {
    font-size: var(--text-section-title);
    line-height: 1.22;
    letter-spacing: -0.035em;
    margin-bottom: var(--space-5);
    max-width: 680px;
  }
  .library-category li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 3px var(--space-4);
    padding-block: 9px;
  }
  .library-category a {
    display: inline-block;
    min-width: 0;
    min-height: 26px;
    color: var(--color-accent-text);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .library-category a:hover {
    color: var(--color-text);
  }
  .resource-meta {
    font: 13px/1.6 var(--font-mono);
    color: var(--color-muted);
    margin-left: auto;
  }
  abbr {
    text-decoration: none;
  }
  .library-index,
  .category-return {
    display: none;
  }
  @media (max-width: 1080px) {
    .library-layout {
      grid-template-columns: 210px minmax(0, 1fr);
      gap: var(--space-10);
    }
    .library-category li {
      display: block;
    }
    .resource-meta {
      display: block;
      margin-top: 3px;
    }
  }
  @media (max-width: 900px) {
    .library-layout {
      display: block;
      padding-top: 0;
    }
    .library-sidebar {
      display: none;
    }
    .category-return {
      display: inline-flex;
      margin-top: var(--space-4);
    }
    .category-return:is(:hover, :focus-visible) > span {
      transform: translateY(-3px);
    }
    .library-index {
      display: block;
      border-bottom: 1px solid var(--color-border);
      margin-bottom: var(--space-8);
    }
    .library-index summary {
      cursor: pointer;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-3);
      min-height: 64px;
      padding-block: var(--space-3);
      font: 13px var(--font-mono);
      list-style: none;
    }
    .library-index summary::-webkit-details-marker {
      display: none;
    }
    .library-index summary::after {
      content: '+';
      font-size: 20px;
      color: var(--color-accent-text);
    }
    .library-index[open] summary::after {
      content: '−';
    }
    .library-index nav {
      padding-bottom: var(--space-5);
    }
    .library-index a {
      display: block;
      padding-block: 10px;
      font-size: var(--text-control);
    }
    .library-category h2 {
      font-size: 26px;
    }
    .library-category li {
      padding-block: 10px;
    }
    .library-category + .library-category {
      margin-top: var(--space-8);
    }
    .page-intro > p {
      font-size: 17px;
    }
    .page-intro {
      padding-bottom: var(--space-9);
    }
  }
  @media (forced-colors: active) {
    .library-category a,
    .library-sidebar a {
      color: LinkText;
    }
    .library-sidebar a[aria-current='location'],
    .library-index a[aria-current='location'] {
      border-left-color: Highlight;
      color: LinkText;
    }
  }
</style>
